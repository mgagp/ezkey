# Copy to `.env` at this repository root (gitignored). Used by scripts under `scripts/cloudflare/`
# that `source` the root `.env` (e.g. deploy-ezkey-org-preview.sh, deploy-ezkey-org-production.sh, deploy-admin-ui-preview.sh, deploy-admin-ui-production.sh).
# You may use `export KEY=value` lines; bash `source` handles them. Naive one-line .env parsers may not — use `KEY=value` or run the provided bash deploy scripts.
# Experimental-hybrid Lightsail export scripts read LIGHTSAIL_SSH_HOST from the environment only
# (not this file); default is ezkey — see experimental-hybrid/README.md.

# Cloudflare API (Wrangler / Pages deploy)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Admin UI — Vite build for Cloudflare Pages (`npm run build:cloudflare` in `ezkey-admin-ui/`).
# Baked into the SPA at build time. Override if your public Admin API hostname differs.
VITE_API_BASE_URL=https://exp1-admin-api.ezkey.org
# Match API EZKEY_ADMIN_AUTH_BROWSER_SESSION_COOKIE_ENABLED when using HttpOnly session cookie.
# VITE_ADMIN_AUTH_USE_HTTP_ONLY_SESSION_COOKIE=true
