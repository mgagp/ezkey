{"openapi":"3.0.1","info":{"title":"Ezkey Admin API","description":"Administration API for Ezkey - Open Source MFA/Passkey Alternative\n\nThis API enables administrative management of Ezkey's main entities:\n- **Integrations**: Applications or systems protected by MFA\n- **Enrollments**: Associations between users, devices and integrations\n- **Auth Attempts**: MFA authentication attempts\n\nThe API follows REST conventions and uses DTOs for all requests and responses.\n","contact":{"name":"Ezkey Team","url":"https://ezkey.org","email":"contributors@ezkey.org"},"license":{"name":"MIT License","url":"https://opensource.org/licenses/MIT"},"version":"1.0.0"},"servers":[{"url":"http://localhost:9080","description":"Development server Admin API"},{"url":"https://admin-api.ezkey.org","description":"Production server Admin API"}],"security":[{"bearerAuth":[]}],"tags":[{"name":"Enrollments","description":"Enrollment management API"},{"name":"Auth Attempts","description":"Authentication attempt management API"},{"name":"Integrations","description":"Integration management API"}],"paths":{"/api/v1/integrations":{"get":{"tags":["Integrations"],"summary":"Retrieve all integrations","description":"Returns the complete list of integrations configured in the system","operationId":"getAll","responses":{"200":{"description":"List retrieved successfully","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/IntegrationResponseDto"}}}}},"500":{"description":"Internal server error","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/IntegrationResponseDto"}}}}}}},"post":{"tags":["Integrations"],"summary":"Create new integration","description":"Creates a new integration with the provided data","operationId":"create","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/IntegrationCreateRequestDto"}}},"required":true},"responses":{"400":{"description":"Invalid data","content":{"*/*":{"schema":{"$ref":"#/components/schemas/IntegrationCreateResponseDto"}}}},"201":{"description":"Integration created successfully","content":{"*/*":{"schema":{"$ref":"#/components/schemas/IntegrationCreateResponseDto"}}}},"500":{"description":"Internal server error","content":{"*/*":{"schema":{"$ref":"#/components/schemas/IntegrationCreateResponseDto"}}}}}}},"/api/v1/enrollments":{"get":{"tags":["Enrollments"],"summary":"Retrieve all enrollments","description":"Returns the complete list of enrollments in the system","operationId":"getAll_1","responses":{"200":{"description":"List retrieved successfully","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/EnrollmentResponseDto"}}}}},"500":{"description":"Internal server error","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/EnrollmentResponseDto"}}}}}}},"post":{"tags":["Enrollments"],"summary":"Create new enrollment","description":"Creates a new enrollment that can later be bound to a mobile device","operationId":"create_1","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/EnrollmentCreateRequestDto"}}},"required":true},"responses":{"400":{"description":"Invalid data","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EnrollmentCreateResponseDto"}}}},"500":{"description":"Internal server error","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EnrollmentCreateResponseDto"}}}},"201":{"description":"Enrollment created successfully","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EnrollmentCreateResponseDto"}}}}}}},"/api/v1/auth-attempts":{"get":{"tags":["Auth Attempts"],"summary":"Retrieve all auth attempts","description":"Returns the complete list of authentication attempts in the system","operationId":"getAll_2","responses":{"200":{"description":"List retrieved successfully","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AuthAttemptDto"}}}}},"500":{"description":"Internal server error","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AuthAttemptDto"}}}}}}},"post":{"tags":["Auth Attempts"],"summary":"Create new auth attempt","description":"Creates a new authentication attempt for MFA validation","operationId":"create_2","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AuthAttemptCreateRequestDto"}}},"required":true},"responses":{"201":{"description":"Auth attempt created successfully","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AuthAttemptCreateResponseDto"}}}},"400":{"description":"Invalid data","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AuthAttemptCreateResponseDto"}}}},"500":{"description":"Internal server error","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AuthAttemptCreateResponseDto"}}}}}}},"/api/v1/integrations/{id}":{"get":{"tags":["Integrations"],"summary":"Retrieve integration by ID","description":"Returns details of a specific integration","operationId":"getById","parameters":[{"name":"id","in":"path","description":"Unique integration ID","required":true,"schema":{"type":"integer","format":"int32"},"example":1}],"responses":{"404":{"description":"Integration not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/IntegrationResponseDto"}}}},"500":{"description":"Internal server error","content":{"*/*":{"schema":{"$ref":"#/components/schemas/IntegrationResponseDto"}}}},"200":{"description":"Integration found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/IntegrationResponseDto"}}}}}},"delete":{"tags":["Integrations"],"summary":"Delete integration","description":"Removes an integration from the system","operationId":"delete","parameters":[{"name":"id","in":"path","description":"Integration ID to delete","required":true,"schema":{"type":"integer","format":"int32"},"example":1}],"responses":{"404":{"description":"Integration not found"},"500":{"description":"Internal server error"},"204":{"description":"Integration deleted successfully"}}}},"/api/v1/enrollments/{id}":{"get":{"tags":["Enrollments"],"summary":"Retrieve enrollment by ID","description":"Returns details of a specific enrollment","operationId":"getById_1","parameters":[{"name":"id","in":"path","description":"Unique enrollment ID","required":true,"schema":{"type":"integer","format":"int32"},"example":1}],"responses":{"200":{"description":"Enrollment found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EnrollmentResponseDto"}}}},"404":{"description":"Enrollment not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EnrollmentResponseDto"}}}},"500":{"description":"Internal server error","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EnrollmentResponseDto"}}}}}},"delete":{"tags":["Enrollments"],"summary":"Delete enrollment","description":"Removes an enrollment from the system","operationId":"delete_1","parameters":[{"name":"id","in":"path","description":"Enrollment ID to delete","required":true,"schema":{"type":"integer","format":"int32"},"example":1}],"responses":{"204":{"description":"Enrollment deleted successfully"},"404":{"description":"Enrollment not found"},"500":{"description":"Internal server error"}}}},"/api/v1/auth-attempts/{id}":{"get":{"tags":["Auth Attempts"],"summary":"Retrieve auth attempt by ID","description":"Returns details of a specific authentication attempt","operationId":"getById_2","parameters":[{"name":"id","in":"path","description":"Unique auth attempt ID","required":true,"schema":{"type":"integer","format":"int32"},"example":1}],"responses":{"500":{"description":"Internal server error","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AuthAttemptDto"}}}},"200":{"description":"Auth attempt found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AuthAttemptDto"}}}},"404":{"description":"Auth attempt not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AuthAttemptDto"}}}}}},"delete":{"tags":["Auth Attempts"],"summary":"Delete auth attempt","description":"Removes an authentication attempt from the system","operationId":"delete_2","parameters":[{"name":"id","in":"path","description":"Auth attempt ID to delete","required":true,"schema":{"type":"integer","format":"int32"},"example":1}],"responses":{"204":{"description":"Auth attempt deleted successfully"},"500":{"description":"Internal server error"},"404":{"description":"Auth attempt not found"}}}},"/api/v1/auth-attempts/{id}/wait":{"get":{"tags":["Auth Attempts"],"summary":"Wait for authentication response","description":"Blocks until authentication attempt is completed or timeout is reached. Provides polling mechanism for synchronous-like behavior in MFA flow.","operationId":"waitForResponse","parameters":[{"name":"id","in":"path","description":"Authentication attempt ID to wait for","required":true,"schema":{"type":"integer","format":"int32"},"example":1},{"name":"timeout","in":"query","description":"Maximum wait duration in seconds","required":false,"schema":{"maximum":300,"minimum":1,"type":"string","default":"30"},"example":30},{"name":"polling","in":"query","description":"Polling interval in seconds","required":false,"schema":{"maximum":60,"minimum":1,"type":"string","default":"2"},"example":2}],"responses":{"200":{"description":"Authentication completed","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AuthAttemptWaitResponseDto"}}}},"500":{"description":"Internal server error","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AuthAttemptWaitResponseDto"}}}},"404":{"description":"Auth attempt not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AuthAttemptWaitResponseDto"}}}},"408":{"description":"Timeout reached, authentication still pending","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AuthAttemptWaitResponseDto"}}}},"400":{"description":"Invalid parameters (timeout, polling)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AuthAttemptWaitResponseDto"}}}}}}}},"components":{"schemas":{"IntegrationCreateRequestDto":{"type":"object","properties":{"logo":{"type":"string","description":"URL or path to the integration's logo image","example":"https://example.com/logo.png"},"i18n":{"type":"array","description":"List of internationalization entries for multi-language support","items":{"$ref":"#/components/schemas/IntegrationI18nCreateDto"}}},"description":"Integration creation data"},"IntegrationI18nCreateDto":{"required":["language","name"],"type":"object","properties":{"language":{"type":"string","description":"Language code for the localized content","example":"en"},"name":{"type":"string","description":"Localized name of the integration","example":"ACME Corporation"},"description":{"type":"string","description":"Localized description of the integration","example":"Secure authentication system for ACME applications"}},"description":"Create DTO for integration internationalization data"},"IntegrationCreateResponseDto":{"type":"object","properties":{"id":{"type":"integer","description":"The unique identifier of the newly created integration","format":"int32","example":42}},"description":"Response DTO for creating new Integration entities"},"EnrollmentCreateRequestDto":{"required":["integrationId","name"],"type":"object","properties":{"integrationId":{"type":"integer","description":"The integration ID to which this enrollment belongs","format":"int32","example":1},"name":{"type":"string","description":"Human-readable name for the enrollment","example":"John's iPhone"},"authAttemptChallengeRequired":{"type":"boolean","description":"Whether authentication attempts require challenge validation","example":true}},"description":"Enrollment creation data"},"EnrollmentCreateResponseDto":{"type":"object","properties":{"enrollmentId":{"type":"integer","description":"Unique identifier of the created enrollment","format":"int32","example":21},"enrollmentChallenge":{"type":"integer","description":"Challenge number for enrollment verification","format":"int32","example":154982}},"description":"Response DTO containing created enrollment details"},"AuthAttemptCreateRequestDto":{"required":["challengeRequested","enrollmentId"],"type":"object","properties":{"enrollmentId":{"type":"integer","description":"The enrollment ID for which the authentication attempt is requested","format":"int32","example":123},"challengeRequested":{"type":"boolean","description":"Indicates whether a challenge is requested for this authentication attempt","example":false}},"description":"Auth attempt creation data"},"AuthAttemptCreateResponseDto":{"type":"object","properties":{"authAttemptId":{"type":"integer","description":"Unique identifier of the created authentication attempt","format":"int32","example":11}},"description":"Response DTO containing created authentication attempt details"},"IntegrationI18nResponseDto":{"type":"object","properties":{"id":{"type":"integer","description":"Unique identifier for the internationalization record","format":"int32","example":1},"language":{"type":"string","description":"Language code for the localized content","example":"en"},"name":{"type":"string","description":"Localized name of the integration","example":"ACME Corporation"},"description":{"type":"string","description":"Localized description of the integration","example":"Secure authentication system for ACME applications"}},"description":"Response DTO for integration internationalization data"},"IntegrationResponseDto":{"type":"object","properties":{"id":{"type":"integer","description":"Unique identifier for the integration","format":"int32","example":1},"logo":{"type":"string","description":"URL or path to the integration logo image","example":"https://example.com/logo.png"},"active":{"type":"boolean","description":"Integration status flag","example":true},"createdAt":{"type":"string","description":"Timestamp when the integration was created","format":"date-time"},"i18n":{"type":"array","description":"List of internationalized content for multiple languages","items":{"$ref":"#/components/schemas/IntegrationI18nResponseDto"}}},"description":"Response DTO containing complete integration details"},"EnrollmentResponseDto":{"type":"object","properties":{"enrollmentId":{"type":"integer","description":"Unique identifier for the enrollment","format":"int32","example":123},"integrationId":{"type":"integer","description":"Integration identifier this enrollment belongs to","format":"int32","example":1},"enrollmentName":{"type":"string","description":"Human-readable name for the enrollment","example":"John's iPhone"},"enrollmentStatus":{"type":"string","description":"Enrollment lifecycle status","example":"VERIFIED","enum":["CREATED","BOUND","VERIFIED","INVALID"]},"enrollmentActive":{"type":"boolean","description":"Flag indicating if the enrollment is currently active","example":true},"enrollmentChallenge":{"type":"integer","description":"Challenge value for enrollment verification","format":"int32","example":123456},"enrollmentProofToken":{"type":"string","description":"Unique code for enrollment verification","example":"EZK-ABC123-DEF456"},"authAttemptChallengeRequired":{"type":"boolean","description":"Flag indicating if authentication attempts require challenge","example":false},"integrationPublicKey":{"type":"string"},"devicePublicKey":{"type":"string"}},"description":"Response DTO containing complete enrollment information for administrative purposes"},"AuthAttemptDto":{"type":"object","properties":{"authAttemptId":{"type":"integer","description":"Unique identifier for the authentication attempt","format":"int32","example":456},"enrollmentId":{"type":"integer","description":"Enrollment identifier this authentication attempt belongs to","format":"int32","example":123},"authAttemptRead":{"type":"boolean","description":"Flag indicating if the authentication attempt has been read by the device","example":true},"authAttemptResponded":{"type":"boolean","description":"Flag indicating if the authentication attempt has been responded to","example":false},"authAttemptValid":{"type":"boolean","description":"Flag indicating if the authentication attempt is valid","example":true},"authAttemptAccepted":{"type":"boolean","description":"Flag indicating if the authentication attempt was accepted","example":true},"authAttemptChallenge":{"type":"integer","description":"Challenge value for the authentication attempt","format":"int32","example":789012},"authAttemptProofToken":{"type":"string","description":"Proof token for the authentication attempt","example":"EZK-XYZ789-ABC123"},"createdAt":{"type":"string","description":"Timestamp when the authentication attempt was created","format":"date-time"},"expiresAt":{"type":"string","description":"Timestamp when the authentication attempt expires","format":"date-time"}},"description":"Response DTO containing complete authentication attempt information for administrative purposes"},"AuthAttemptWaitResponseDto":{"type":"object","properties":{"authAttempt":{"$ref":"#/components/schemas/AuthAttemptDto"},"status":{"type":"string","description":"Calculated authentication status","example":"ACCEPTED","enum":["PENDING","READ","INVALID","REJECTED","ACCEPTED"]},"completed":{"type":"boolean","description":"Whether authentication process is complete","example":true},"timeoutReached":{"type":"boolean","description":"Whether wait ended due to timeout","example":false},"waitDuration":{"type":"integer","description":"Actual duration waited in seconds","format":"int32","example":15},"completedAt":{"type":"string","description":"Timestamp when wait operation completed","format":"date-time"}},"description":"Response DTO for authentication wait operation"}},"securitySchemes":{"bearerAuth":{"type":"http","description":"JWT authentication token for admin API","scheme":"bearer","bearerFormat":"JWT"}}}}