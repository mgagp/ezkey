ntegrationCreateRequestDto":{"type":"object","properties":{"logo":{"type":"string","description":"URL or path to the integration's logo image","example":"https://example.com/logo.png"},"i18n":{"type":"array","description":"List of internationalization entries for multi-language support","items":{"$ref":"#/components/schemas/IntegrationI18nCreateDto"}}},"description":"Integration creation data"},"IntegrationI18nCreateDto":{"required":["language","name"],"type":"object","properties":{"language":{"type":"string","description":"Language code for the localized content","example":"en"},"name":{"type":"string","description":"Localized name of the integration","example":"ACME Corporation"},"description":{"type":"string","description":"Localized description of the integration","example":"Secure authentication system for ACME applications"}},"description":"Create DTO for integration internationalization data"},"IntegrationCreateResponseDto":{"type":"object","properties":{"id":{"type":"integer","format":"int32"}},"description":"Response DTO for creating new Integration entities"},"EnrollmentCreateRequestDto":{"required":["integrationId","name"],"type":"object","properties":{"integrationId":{"type":"integer","description":"The integration ID to which this enrollment belongs","format":"int32","example":1},"name":{"type":"string","description":"Human-readable name for the enrollment","example":"John's iPhone"},"authAttemptChallengeRequired":{"type":"boolean","description":"Whether authentication attempts require challenge validation","example":true}},"description":"Enrollment creation data"},"EnrollmentCreateResponseDto":{"type":"object","properties":{"enrollmentId":{"type":"integer","description":"Unique identifier of the created enrollment","format":"int32","example":21},"enrollmentChallenge":{"type":"integer","description":"Challenge number for enrollment verification","format":"int32","example":154982}},"description":"Response DTO containing created enrollment details"},"AuthAttemptCreateRequestDto":{"type":"object","properties":{"enrollmentId":{"type":"integer","format":"int32"},"challengeRequested":{"type":"boolean"}},"description":"Auth attempt creation data"},"AuthAttemptCreateResponseDto":{"type":"object","properties":{"authAttemptId":{"type":"integer","description":"Unique identifier of the created authentication attempt","format":"int32","example":11}},"description":"Response DTO containing created authentication attempt details"},"IntegrationI18nResponseDto":{"type":"object","properties":{"id":{"type":"integer","description":"Unique identifier for the internationalization record","format":"int32","example":1},"language":{"type":"string","description":"Language code for the localized content","example":"en"},"name":{"type":"string","description":"Localized name of the integration","example":"ACME Corporation"},"description":{"type":"string","description":"Localized description of the integration","example":"Secure authentication system for ACME applications"}},"description":"Response DTO for integration internationalization data"},"IntegrationResponseDto":{"type":"object","properties":{"id":{"type":"integer","description":"Unique identifier for the integration","format":"int32","example":1},"logo":{"type":"string","description":"URL or path to the integration logo image","example":"https://example.com/logo.png"},"active":{"type":"boolean","description":"Integration status flag","example":true},"createdAt":{"type":"string","description":"Timestamp when the integration was created","format":"date-time"},"i18n":{"type":"array","description":"List of internationalized content for multiple languages","items":{"$ref":"#/components/schemas/IntegrationI18nResponseDto"}}},"description":"Response DTO containing complete integration details"},"EnrollmentResponseDto":{"type":"object","properties":{"enrollmentId":{"type":"integer","format":"int32"},"integrationId":{"type":"integer","format":"int32"},"enrollmentName":{"type":"string"},"enrollm