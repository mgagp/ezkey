# =============================================================================
# Ezkey Demo App ACME - External Configuration Override
# =============================================================================
# This file overrides properties from the JAR's application.properties
# Changes can be hot-reloaded via the "RELOAD CONFIG" button on the login page
# or by calling: POST /actuator/refresh
#
# Location:
#   - Docker: /app/config/application.properties (mounted volume)
#   - Local: ./config/application.properties (next to JAR)
# =============================================================================

# EZKey Admin API URL
# For Docker: Use internal service name (admin-api:9080)
# For local IDE: Use http://localhost:9080
ezkey.admin.api.url=http://admin-api:9080

# API Key credentials for machine-to-machine (Integration API) authentication
# IMPORTANT: Set these after creating an integration via Admin API and generating an API key
#
# Steps to get API key credentials:
#   1. Login to Admin API as Global Admin
#   2. Create an integration for ACME Demo App
#   3. Generate an API key for that integration
#   4. Copy the integrationKey and secretKey from the response
#   5. Set both values here
#
# Authentication Format:
#   Authorization: Basic base64(integrationKey:secretKey)
#
# Example:
#   ezkey.integration-key=ezkey_ikey_98dddb45c5d2d610a929
#   ezkey.secret-key=ezkey_skey_746e2334d1f8dc5bc5cdd0281dea2d9ad4c1669d
#
# Note: Both keys are required for authentication attempts to work
# Leave empty initially - application will start but login will fail until configured
ezkey.integration-key=
ezkey.secret-key=

# =============================================================================
# Optional Overrides
# =============================================================================

# Logging level (uncomment to enable debug logging)
# logging.level.org.ezkey.demo.acme=DEBUG
# logging.level.org.springframework.web=DEBUG
