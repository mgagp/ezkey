{
  "help": {
    "integrityLifecycle": {
      "content": "Chain checkpoints seal batches of audit entries every 5 minutes. Use <strong>Verify chain</strong> and <strong>Verify entry HMAC</strong> for read-only forensic checks (no alert side effects). Use <strong>Run validation</strong> for the detective batch path — same semantics as the nightly job — which may raise or touch an <strong>AUDIT_INTEGRITY_RUPTURE</strong> alert when alert-eligible violations remain. Use <strong>Lifecycle overview</strong> to understand what is currently sealed, awaiting archive confirmation, or approaching purge eligibility. Manual lifecycle actions remain exceptional maintenance paths, not the normal operator workflow."
    },
    "sealArchive": {
      "content": "Seals a range of checkpoints for archival (e.g. before dropping a DB partition). You can specify a period by timestamps or by checkpoint IDs. A pre-flight integrity check runs automatically."
    },
    "declareGap": {
      "content": "When the system was offline longer than the scheduler lookback (e.g. 60 min), declare each detected gap from the list below to keep lifecycle continuity explicit. Use <strong>Locate in timeline</strong> to see the gap in context, then <strong>Declare</strong> to formally close it with a justification. This is a recovery action, not a normal operator workflow."
    },
    "exceptionalMaintenance": {
      "content": "Use these actions only for exceptional maintenance or recovery. Normal lifecycle progression is policy-driven and system-executed; the primary UI posture is observability, not manual lifecycle orchestration."
    },
    "incidents": {
      "content": "Operational incidents record stalled Admin API checkpoints as seen by peripheral supervision (heartbeat). With default Docker settings, peripherals refuse only <strong>new MFA work</strong> (narrow HTTP routes — see <strong>docs/AUDIT_LOG_INTEGRITY.md</strong>) after about <strong>9 minutes beyond the latest checkpoint <code>window_end</code></strong>; audit rows elsewhere may continue. Use <strong>Declare gap</strong> for undeclared <em>cryptographic</em> time holes — a different lifecycle. After recovery, declare closure here whenever an incident still awaits justification."
    },
    "checkpointTimeline": {
      "content": "Lists chain checkpoints; sort by <strong>Window start</strong> to see inline gap rows (undeclared holes between checkpoints). Other sorts show checkpoints only. Use this table to inspect checkpoint type, lifecycle state, and anomaly boundaries."
    }
  },
