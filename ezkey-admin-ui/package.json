{
  "name": "ezkey-admin-ui",
  "private": true,
  "version": "0.2.0-SNAPSHOT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate:api": "orval --config orval.config.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:cloudflare": "npm run generate:api && tsc -b && vite build --mode cloudflare",
    "build:cloudflare:verify": "npm run build:cloudflare && bash scripts/assert-no-demo-in-build.sh dist",
    "build:test": "tsc -b && vite build --mode test",
    "doctor:curated": "node scripts/doctor-curated.mjs",
    "lint": "eslint .",
    "lint:diagnostics": "eslint . --format stylish",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:browser:headed": "playwright test --headed",
    "test:browser:debug": "playwright test --debug",
    "test:browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.2",
    "@tanstack/react-query": "^5.105.3",
    "clsx": "^2.1.1",
    "i18next": "^26.7.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "lucide-react": "^1.67.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.12",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.9",
    "js-yaml": "4.3.2",
    "linkify-it": "5.0.2",
    "browserslist": "4.28.9",
    "baseline-browser-mapping": "2.11.23"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "orval": "8.46.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
