# Override root .gitignore: package-lock.json must be committed for reproducible Docker builds
!package-lock.json

# OpenAPI spec — generated via scripts/update-specs.sh, always committed
# openapi-spec.json

# Orval-generated API client code — regenerated at build time
src/generated/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# This package is npm (package-lock.json). A Yarn lockfile is not an input.
yarn.lock

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
