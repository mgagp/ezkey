# In development, VITE_API_BASE_URL is empty — Vite proxy handles /api/* → localhost:9080
VITE_API_BASE_URL=

# Demo mode: when true, enables Fill-demo in create dialogs and Ctrl+click on sidebar brand.
# Omit or set to false to disable. Production builds always strip demo code via vite define.
VITE_DEMO_MODE=true
