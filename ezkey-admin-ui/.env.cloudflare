# Used with: npm run build:cloudflare (vite --mode cloudflare)
# Admin API public origin for split UI/API hosting (e.g. Cloudflare Pages → Lightsail).
#
# No product default hostname. Set VITE_API_BASE_URL explicitly for your surface:
#   - export / root .env (preferred with scripts/cloudflare/deploy-admin-ui-*.sh --build)
#   - or uncomment one example below
#   - or use .env.cloudflare.local (gitignored)
#
# EXP1 (lab playbook):
# VITE_API_BASE_URL=https://exp1-admin-api.ezkey.org
#
# Community (ezkey.online):
# VITE_API_BASE_URL=https://admin-api.ezkey.online
#
# VITE_API_BASE_URL=

# Match API EZKEY_ADMIN_AUTH_BROWSER_SESSION_COOKIE_ENABLED=true when using HttpOnly session cookie.
VITE_ADMIN_AUTH_USE_HTTP_ONLY_SESSION_COOKIE=true
# Optional overrides only if the Admin API CSRF cookie/header names are changed from defaults.
# VITE_ADMIN_AUTH_CSRF_COOKIE_NAME=EZKEY_ADMIN_CSRF
# VITE_ADMIN_AUTH_CSRF_HEADER_NAME=X-CSRF-TOKEN
