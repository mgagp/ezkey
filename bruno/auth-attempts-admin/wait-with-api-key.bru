meta {
  name: wait with api key
  type: http
  seq: 9
}

get {
  url: {{base_url_admin_api}}/api/v1/auth-attempts/:id/wait
  body: none
  auth: basic
}

params:query {
  @description('Maximum wait duration in seconds (1-300, default: 30)')
  ~timeout: 30
  @description('Polling interval in seconds (1-60, default: 2)')
  ~polling: 2
}

params:path {
  @description('The authentication attempt ID to wait for')
  id: {{authAttemptId}}
}

auth:basic {
  username: {{integrationKey}}
  password: {{secretKey}}
}

script:post-response {
  test("Status code is 401 (Admin API does not authenticate API keys)", function () {
      expect(res.getStatus()).to.equal(401);
  });
}

docs {
  Admin API does not authenticate API keys (401). Use `auth-attempts-integration-api/wait.bru`
  for the canonical M2M path.
}
