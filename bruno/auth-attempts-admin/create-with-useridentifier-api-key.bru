meta {
  name: create with userIdentifier (API key)
  type: http
  seq: 3
}

post {
  url: {{base_url_admin_api}}/api/v1/auth-attempts
  body: json
  auth: basic
}

auth:basic {
  username: {{integrationKey}}
  password: {{secretKey}}
}

body:json {
  {
      "userIdentifier": "alice",
      "challengeRequested": false
  }
}

script:post-response {
  test("Status code is 401 (Admin API does not authenticate API keys)", function () {
      expect(res.getStatus()).to.equal(401);
  });
}

settings {
  encodeUrl: true
}

docs {
  Admin API does not authenticate API keys (401), including userIdentifier create.
  Use `auth-attempts-integration-api/create-with-useridentifier.bru` for the canonical M2M path.
}
