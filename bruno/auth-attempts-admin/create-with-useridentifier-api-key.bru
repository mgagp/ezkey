meta {
  name: create with userIdentifier (API key)
  type: http
  seq: 3
}

post {
  url: {{base_url_admin_api}}/api/v1/auth-attempts
  body: json
  auth: basic
}

auth:basic {
  username: {{integrationKey}}
  password: {{secretKey}}
}

body:json {
  {
      "userIdentifier": "alice",
      "challengeRequested": false
  }
}

settings {
  encodeUrl: true
}

docs {
  Creates an auth attempt using userIdentifier instead of enrollmentId. Use when your app identifies users by username. Integration is derived from API key. Requires enrollment with matching user_identifier in the integration.
}
