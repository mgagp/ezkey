meta {
  name: cancel with api key
  type: http
  seq: 11
}

post {
  url: {{base_url_admin_api}}/api/v1/auth-attempts/:id/cancel
  body: none
  auth: basic
}

params:path {
  @description('The authentication attempt ID to cancel')
  id: {{authAttemptId}}
}

auth:basic {
  username: {{integrationKey}}
  password: {{secretKey}}
}

script:post-response {
  test("Status code is 401 (Admin API does not authenticate API keys)", function () {
      expect(res.getStatus()).to.equal(401);
  });
}

docs {
  Admin API does not authenticate API keys (401). Use `auth-attempts-integration-api/cancel.bru`
  for the canonical M2M path.
}
