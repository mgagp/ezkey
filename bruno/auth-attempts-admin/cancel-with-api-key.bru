meta {
  name: cancel with api key
  type: http
  seq: 11
}

post {
  url: {{base_url_admin_api}}/api/v1/auth-attempts/:id/cancel
  body: none
  auth: basic
}

params:path {
  @description('The authentication attempt ID to cancel')
  id: {{authAttemptId}}
}

auth:basic {
  username: {{integrationKey}}
  password: {{secretKey}}
}

script:post-response {
  test("Status code is 403 (API-key auth attempts disabled by default on Admin API)", function () {
      expect(res.getStatus()).to.equal(403);
  });

  test("RFC 9457 problem type points to api-key-auth-attempts-disabled", function () {
      var jsonData = res.getBody();
      expect(jsonData.type).to.equal('https://ezkey.io/problems/admin/api-key-auth-attempts-disabled');
  });
}

docs {
  Default Admin API posture rejects API-key cancel. Use `auth-attempts-integration-api/cancel.bru` for the
  canonical M2M path. Opt-in: `ezkey.admin.auth.api-key-auth-attempts-enabled=true` (minimal install only).
}
