meta {
  name: create with api key
  type: http
  seq: 2
}

post {
  url: {{base_url_admin_api}}/api/v1/auth-attempts
  body: json
  auth: basic
}

auth:basic {
  username: {{integrationKey}}
  password: {{secretKey}}
}

body:json {
  {
      "enrollmentId": {{enrollmentId}},
      "challengeRequested": false
  }
}

script:post-response {
  test("Status code is 403 (API-key auth attempts disabled by default on Admin API)", function () {
      expect(res.getStatus()).to.equal(403);
  });

  test("RFC 9457 problem type points to api-key-auth-attempts-disabled", function () {
      var jsonData = res.getBody();
      expect(jsonData).to.have.property('type');
      expect(jsonData.type).to.equal('https://ezkey.io/problems/admin/api-key-auth-attempts-disabled');
  });
}

settings {
  encodeUrl: true
}

docs {
  **Default posture (deny):** Admin API rejects API-key M2M auth-attempt traffic with HTTP 403 and
  RFC 9457 `https://ezkey.io/problems/admin/api-key-auth-attempts-disabled`.

  **Canonical happy path:** use `auth-attempts-integration-api/create.bru` against
  `{{base_url_integration_api}}` (port 7080).

  **Minimal install opt-in:** only when Integration API is not deployed, set
  `ezkey.admin.auth.api-key-auth-attempts-enabled=true` on Admin API; then this request can return 201.

  **Authentication:** HTTP Basic Auth with `integrationKey:secretKey`
}
