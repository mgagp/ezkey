meta {
  name: create with api key
  type: http
  seq: 2
}

post {
  url: {{base_url_admin_api}}/api/v1/auth-attempts
  body: json
  auth: basic
}

auth:basic {
  username: {{integrationKey}}
  password: {{secretKey}}
}

body:json {
  {
      "enrollmentId": {{enrollmentId}},
      "challengeRequested": false
  }
}

script:post-response {
  test("Status code is 401 (Admin API does not authenticate API keys)", function () {
      expect(res.getStatus()).to.equal(401);
  });
}

settings {
  encodeUrl: true
}

docs {
  **Negative contract:** Admin API does not authenticate API keys. HTTP Basic credentials
  on this host return HTTP 401 Unauthorized.

  **Canonical happy path:** use `auth-attempts-integration-api/create.bru` against
  `{{base_url_integration_api}}` (port 7080).
}
