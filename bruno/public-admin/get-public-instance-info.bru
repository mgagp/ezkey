meta {
  name: get public instance info
  type: http
  seq: 1
}

get {
  url: {{base_url_admin_api}}/api/v1/public/instance-info
  body: none
  auth: inherit
}

script:post-response {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  if (res.getStatus() === 200) {
      var jsonData = res.getBody();
  
      test("Response contains instanceName", function () {
          expect(jsonData).to.have.property('instanceName');
          expect(jsonData.instanceName).to.be.a('string');
      });
  
      test("Response contains instanceDescription", function () {
          expect(jsonData).to.have.property('instanceDescription');
      });
  
      test("Response contains authApiPublicBaseUrl (nullable)", function () {
          expect(jsonData).to.have.property('authApiPublicBaseUrl');
      });
  
      test("Response contains aboutUrl (nullable)", function () {
          expect(jsonData).to.have.property('aboutUrl');
      });

      test("Response contains productVersion (nullable, #1477)", function () {
          expect(jsonData).to.have.property('productVersion');
      });

      test("gitShortSha is null or 7 hex characters (#1477)", function () {
          expect(jsonData).to.have.property('gitShortSha');
          if (jsonData.gitShortSha !== null) {
              expect(jsonData.gitShortSha).to.match(/^[0-9a-f]{7}$/);
          }
      });

      test("No self-registration flag (retired, #1368)", function () {
          expect(jsonData).to.not.have.property('evaluatorSelfRegistrationEnabled');
      });
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns read-only instance metadata for branding and operator visibility.
  
  **No authentication required.**
  
  **Response (200 OK):**
  - `instanceName` (string): from `ezkey.organization.name`
  - `instanceDescription` (string): from `ezkey.organization.description`
  - `aboutUrl` (string | null): from `ezkey.organization.about-url` when set
  - `authApiPublicBaseUrl` (string | null): from `ezkey.qr.auth-base-url`; same value as `authUrl` in enrollment QR JSON when configured
  - `productVersion` (string | null): product SemVer from build-info (#1477)
  - `gitShortSha` (string | null): 7-character git SHA of the image (`OCI_IMAGE_REVISION`); null when not stamped (#1477)
  
  **Status codes:**
  - 200: OK
  - 500: Internal server error
}
