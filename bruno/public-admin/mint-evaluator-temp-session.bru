meta {
  name: Mint temporary evaluator console session
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/v1/admin/auth/evaluator-temp
  body: json
  auth: none
}

body:json {
  {
    "enrollmentId": {{enrollmentId}},
    "enrollmentProofToken": "{{enrollmentProofToken}}"
  }
}

docs {
  Gated by `ezkey.evaluator.self-registration.enabled`. The tenant must be self-registered
  (anonymous evaluator signup); other tenants are refused. Use enrollment material from
  POST /admin/auth/activate. One-shot EVALUATOR_TEMP session; do not log the token.
}
