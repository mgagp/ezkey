meta {
  name: get qrcode
  type: http
  seq: 6
}

get {
  url: {{base_url_admin_api}}/api/v1/enrollments/:id/qrcode
  body: none
  auth: inherit
}

params:path {
  @description('The enrollment ID')
  id: {{enrollmentId}}
}

script:post-response {
  test("Status code is 200, 400, or 404", function () {
      expect([200, 400, 404]).to.include(res.getStatus());
  });
  
  if (res.getStatus() === 200) {
      test("Response is PNG image", function () {
          expect(res.getHeader('Content-Type')).to.include('image/png');
      });
      
      test("Response has content", function () {
          expect(res.getBody()).to.not.be.empty;
      });
  }
}

settings {
  encodeUrl: true
}

docs {
  Generates a QR code image (PNG) containing enrollment credentials for easy mobile device binding.
  
  **QR Code Format (JSON):**
  The QR code contains enrollment credentials in JSON format:
  ```json
  {"enrollmentId":"4","enrollmentProofToken":"abc123def456...","authUrl":"https://ezkey.acme.com:8080"}
  ```
  
  The `authUrl` field is only included when `ezkey.qr.auth-base-url` is configured on the server. When absent, the mobile app uses its default base URL.
  
  **Path Parameters:**
  - `id` (required): Enrollment ID to generate QR code for
  
  **Response (200 OK):**
  - Content-Type: `image/png`
  - Body: PNG image bytes (300x300 pixels)
  - Content-Disposition: `inline; filename=enrollment-{id}-qrcode.png`
  
  **Status Codes:**
  - 200: QR code generated successfully
  - 400: Enrollment missing proof token
  - 401: Unauthorized - admin token required
  - 404: Enrollment not found
  - 500: Internal server error
  
  **Usage:**
  - The QR code can be scanned by the Ezkey mobile application to automatically populate enrollment credentials
  - Eliminates manual entry and reduces errors
  - Can be viewed directly in Postman or tested with online QR readers
}
