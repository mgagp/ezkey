meta {
  name: get alert by id
  type: http
  seq: 2
}

get {
  url: {{base_url_admin_api}}/api/v1/alerts/{{alertId}}
  body: none
  auth: inherit
}

script:post-response {
  test("Status code is 200 or 404", function () {
      expect([200, 404]).to.include(res.getStatus());
  });
  
  if (res.getStatus() === 200) {
      var jsonData = res.getBody();
      expect(jsonData).to.have.property('alertId');
      expect(jsonData).to.have.property('alertType');
      expect(jsonData).to.have.property('severity');
      expect(jsonData).to.have.property('status');
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns the alert with the given identifier. 404 if no alert is found.
  
  **Access:** Global Admin only (403 for Tenant Admin).
  
  **Tip:** For `AUDIT_CHAIN_GAP_PENDING` alerts, `payload` contains `anchorCheckpointId`. Use it with `POST /api/v1/audit-logs/lifecycle/declare-gap` to declare the gap; the open alert is auto-resolved with reason `GAP_DECLARED`.
}
