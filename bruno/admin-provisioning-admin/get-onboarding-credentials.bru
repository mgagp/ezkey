meta {
  name: get onboarding credentials
  type: http
  seq: 8
}

get {
  url: {{base_url_admin_api}}/api/v1/admins/:id/onboarding
  body: none
  auth: inherit
}

params:path {
  @description('The administrator ID to retrieve onboarding credentials for')
  id: {{adminId}}
}

script:post-response {
  test("Status code is 200, 400, 403, or 404", function () {
      expect([200, 400, 403, 404]).to.include(res.getStatus());
  });
  
  if (res.getStatus() === 200) {
      var jsonData = res.getBody();
      
      // #1266: bind material depends on the enrollment status, so save only what is present.
      bru.setEnvVar("adminEnrollmentId", jsonData.enrollmentId.toString());
      if (jsonData.enrollmentProofToken != null) {
          bru.setEnvVar("adminEnrollmentProofToken", jsonData.enrollmentProofToken);
      }
      if (jsonData.enrollmentChallenge != null) {
          bru.setEnvVar("adminEnrollmentChallenge", jsonData.enrollmentChallenge.toString());
      }
      
      test("Response contains required fields", function () {
          expect(jsonData).to.have.property('enrollmentId');
          expect(jsonData).to.have.property('enrollmentProofToken');
          expect(jsonData).to.have.property('enrollmentChallenge');
      });
      
      test("A proof token implies a challenge", function () {
          if (jsonData.enrollmentProofToken != null) {
              expect(jsonData.enrollmentProofToken).to.be.a('string');
              expect(jsonData.enrollmentProofToken.length).to.be.greaterThan(0);
              expect(jsonData.enrollmentChallenge).to.be.a('number');
          }
      });
      
      test("Recovery codes are null (cannot be retrieved after initial provisioning)", function () {
          expect(jsonData.recoveryCodes).to.be.null;
      });
  }
}

settings {
  encodeUrl: true
}

docs {
  Retrieves onboarding credentials for an administrator. Sensitive credentials (enrollmentProofToken, enrollmentChallenge) are separated from the creation response for security reasons.
  
  **Permissions:**
  - **GlobalAdmin**: Can retrieve onboarding credentials for any admin
  - **TenantAdmin**: Can only retrieve onboarding credentials for admins in their tenant
  - **TenantAdmin for different tenant (or a Global Admin target)**: Returns 404 Not Found (hide-existence: same answer as an unknown id)
  
  **Path Parameters:**
  - `id` (required): Administrator ID to retrieve onboarding credentials for
  
  **Response (200 OK):**
  - `enrollmentId`: Enrollment ID for passwordless authentication
  - `enrollmentProofToken`: Enrollment proof token while the enrollment is `CREATED`; null afterwards
  - `enrollmentChallenge`: Enrollment challenge code, 6 digits, while the enrollment is `CREATED` or `BOUND`; null afterwards
  - `recoveryCodes`: null (plain recovery codes are never revealed from onboarding retrieval)
  
  **Status Codes:**
  - 200: Onboarding credentials retrieved successfully
  - 400: Bad request (e.g., admin does not have an enrollment)
  - 401: Unauthorized - admin token required
  - 403: Forbidden - caller is not an administrator
  - 404: Administrator or enrollment not found, or administrator outside the caller's tenant (hide-existence: same answer as an unknown id)
  - 500: Internal server error
  
  **Security Note:**
  - Plain recovery codes are issued only by POST `/api/v1/admins/{id}/recovery-codes/issue-initial` or `/recovery-codes/regenerate`; this endpoint returns `recoveryCodes: null`
  - Hashed codes are stored server-side; this endpoint follows the same pattern as GET `/api/v1/enrollments/{id}` for secrets
}
