meta {
  name: 1 crypto generate device proof token
  type: http
  seq: 1
}

get {
  url: {{base_url_crypto_api}}/api/v1/crypto/prooftoken
  body: none
  auth: inherit
}

script:post-response {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  if (res.getStatus() === 200) {
      var jsonData = res.getBody();
      bru.setEnvVar("device_proofToken", jsonData.proofToken);
      
      test("Response contains proofToken", function () {
          expect(jsonData).to.have.property('proofToken');
          expect(jsonData.proofToken).to.be.a('string');
      });
  }
}

settings {
  encodeUrl: true
}

docs {
  Generates a unique proof token for device authentication. This token is used to prove the device's authenticity when checking for pending authentication attempts.
  
  **Response (200 OK):**
  - `proofToken`: Unique proof token string
  
  **Usage:** This token must be signed with the device's private key and included in the pending request.
}
