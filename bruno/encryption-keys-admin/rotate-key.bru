meta {
  name: rotate key
  type: http
  seq: 4
}

post {
  url: {{base_url_admin_api}}/api/v1/encryption-keys/rotate
  body: none
  auth: inherit
}

params:query {
  @description('Audit justification for the manual key rotation (min 10 characters, recommended for reason/justification on sensitive change)')
  ~reason: {{reason}}
}

script:post-response {
  test("Status code is 200, 409, or 500", function () {
      expect([200, 409, 500]).to.include(res.getStatus());
  });
  
  if (res.getStatus() === 200) {
      var jsonData = res.getBody();
      bru.setEnvVar("newPrimaryKeyId", jsonData.newPrimaryKeyId);
      test("Rotation successful", function () {
          expect(jsonData.newPrimaryKeyId).to.be.a('number');
          expect(jsonData.message).to.include('PENDING');
      });
  }
}

settings {
  encodeUrl: true
}

docs {
  Manually triggers encryption key rotation. This introduces a new key with PENDING status; it is promoted to primary automatically once the synchronization window elapses. Useful for emergency rotations or testing. ⚠️ Use with caution in production.
  
  - 409: a PENDING key already exists, rotation is inactive, or another node changed the keyset first (lost CAS race; retry is safe).
  - 500: rotation failed, including a keyset storage failure (audited as REENCRYPTION_FAILED; fix storage before retrying, #1506).
}
