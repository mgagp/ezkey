meta {
  name: resume batch
  type: http
  seq: 6
}

post {
  url: {{base_url_admin_api}}/api/v1/encryption-keys/reencryption-batches/:batchId/resume
  body: none
  auth: inherit
}

params:path {
  @description('The re-encryption batch ID')
  batchId: {{reencryptionBatchId}}
}

script:post-response {
  test("Status code is 202, 404, 409, or 500", function () {
      expect([202, 404, 409, 500]).to.include(res.getStatus());
  });

  if (res.getStatus() === 409) {
      test("COMPLETED or IN_PROGRESS batch refused as a state conflict (#1431)", function () {
          var problem = res.getBody();
          expect(problem.status).to.equal(409);
          expect(problem.detail).to.match(/is (COMPLETED|IN_PROGRESS)/);
      });
  }
  
  if (res.getStatus() === 202) {
      var jsonData = res.getBody();
      test("Resume accepted", function () {
          expect(jsonData.batchId).to.be.a('number');
          expect(jsonData.message).to.be.a('string');
      });
  }
}

settings {
  encodeUrl: true
}

docs {
  Accepts resume for a FAILED, PENDING or PAUSED re-encryption batch (202 Accepted); the retry budget is not checked. A COMPLETED or IN_PROGRESS batch is refused with 409 (RFC 9457 state-conflict, #1431); a stored IN_PROGRESS is an orphan from a stopped run, never a live batch (a running batch reads PENDING, see #1550). Use the batchId from the list re-encryption batches response; progress appears in the batches table when the batch ends (one transaction per batch).
}
