meta {
  name: get key by ID
  type: http
  seq: 3
}

get {
  url: {{base_url_admin_api}}/api/v1/encryption-keys/:keyId
  body: none
  auth: inherit
}

params:path {
  @description('The encryption key ID')
  keyId: {{encryptionKeyId}}
}

script:post-response {
  test("Status code is 200 or 404", function () {
      expect([200, 404]).to.include(res.getStatus());
  });
  
  if (res.getStatus() === 200) {
      var jsonData = res.getBody();
      test("Key ID matches", function () {
          expect(jsonData.keyId.toString()).to.equal(bru.getEnvVar('encryptionKeyId') || '{{encryptionKeyId}}');
      });
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns details for a specific encryption key by its ID. Use the keyId from the list keys response.
}
