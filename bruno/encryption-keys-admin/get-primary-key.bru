meta {
  name: get primary key
  type: http
  seq: 2
}

get {
  url: {{base_url_admin_api}}/api/v1/encryption-keys/primary
  body: none
  auth: inherit
}

script:post-response {
  test("Status code is 200 or 404", function () {
      expect([200, 404]).to.include(res.getStatus());
  });
  
  if (res.getStatus() === 200) {
      var jsonData = res.getBody();
      bru.setEnvVar("primaryKeyId", jsonData.keyId);
      test("Key status is PRIMARY", function () {
          expect(jsonData.keyStatus).to.equal('PRIMARY');
      });
  }
}

settings {
  encodeUrl: true
}

docs {
  Returns the current primary encryption key used for new encryption operations. Returns 404 if no primary key is found.
}
