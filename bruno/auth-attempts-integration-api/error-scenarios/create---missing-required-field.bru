meta {
  name: create - missing required field
  type: http
  seq: 1
}

post {
  url: {{base_url_integration_api}}/api/v1/auth-attempts
  body: json
  auth: basic
}

auth:basic {
  username: {{integrationKey}}
  password: {{secretKey}}
}

body:json {
  {
      "enrollmentId": {{enrollmentId}}
  }
}

script:post-response {
  test("Status code is 400", function () {
      expect(res.getStatus()).to.equal(400);
  });
  
  test("Response is RFC 9457 problem detail", function () {
      var jsonData = res.getBody();
      expect(jsonData).to.have.property('status');
      expect(jsonData.status).to.equal(400);
  });
}

settings {
  encodeUrl: true
}

docs {
  Omits `challengeRequested` which is required. Expects 400 Bad Request with a RFC 9457 problem detail response.
}
