meta {
  name: cancel - already completed attempt
  type: http
  seq: 6
}

post {
  url: {{base_url_integration_api}}/api/v1/auth-attempts/:id/cancel
  body: none
  auth: basic
}

params:path {
  @description('Run this after the attempt is already ACCEPTED or EXPIRED')
  id: {{authAttemptId}}
}

auth:basic {
  username: {{integrationKey}}
  password: {{secretKey}}
}

script:post-response {
  test("Status code is 400", function () {
      expect(res.getStatus()).to.equal(400);
  });
  
  test("RFC 9457 problem detail", function () {
      var jsonData = res.getBody();
      expect(jsonData).to.have.property('status');
      expect(jsonData.status).to.equal(400);
  });
}

settings {
  encodeUrl: true
}

docs {
  Attempts to cancel an auth attempt that is already in a final state (ACCEPTED, REJECTED, INVALID, or EXPIRED). Expects 400 Bad Request.
  
  To use: first run `create` + let the attempt complete (via auth API), then run this cancel request.
}
