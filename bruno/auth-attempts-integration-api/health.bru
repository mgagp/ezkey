meta {
  name: health
  type: http
  seq: 9
}

get {
  url: {{base_url_integration_api_mgmt}}/actuator/health
  body: none
  auth: none
}

script:post-response {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Service is UP", function () {
      var jsonData = res.getBody();
      expect(jsonData.status).to.equal('UP');
  });
  
  console.log('Integration API health:', res.getBody().status);
}

settings {
  encodeUrl: true
}

docs {
  Checks Integration API health via Spring Boot Actuator. No authentication required.
  
  The management port (7081) is separate from the API port (7080). Uses `{{base_url_integration_api_mgmt}}` (default: `http://localhost:7081`).
}
