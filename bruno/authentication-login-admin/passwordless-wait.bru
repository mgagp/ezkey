meta {
  name: passwordless-wait
  type: http
  seq: 2
}

post {
  url: {{base_url_admin_api}}/api/v1/admin/auth/passwordless-wait
  body: json
  auth: inherit
}

body:json {
  {
    "authAttemptId": {{authAttemptId}},
    "challengeCode": {{challengeCode}}
  }
  
}

script:post-response {
  test("Status code is 200, 403, or 400", function () {
      expect([200, 403, 400]).to.include(res.getStatus());
  });
  
  if (res.getStatus() === 200) {
      var jsonData = res.getBody();
      
      if (jsonData.success === true) {
          bru.setEnvVar("token", jsonData.token);
          
          // Extract multi-tenancy fields (Phase 1)
          if (jsonData.adminType) {
              bru.setEnvVar("adminType", jsonData.adminType);
          }
          if (jsonData.tenantId !== undefined && jsonData.tenantId !== null) {
              bru.setEnvVar("tenantId", jsonData.tenantId.toString());
          }
          
          test("Response contains token", function () {
              expect(jsonData).to.have.property('token');
              expect(jsonData.token).to.be.a('string');
          });
      }
  }
}

settings {
  encodeUrl: true
}

docs {
  Waits for device approval in the passwordless authentication flow. Supports two authentication flows:
  
  **Challenge Flow (challengeRequested=true in login):**
  - Provides both authAttemptId and challengeCode from login response
  - Endpoint verifies challengeCode to prevent enumeration attacks
  - If a stored attempt has a challenge, missing challengeCode is rejected
  - Long-running HTTP: server waits up to remaining attempt lifetime (from row `expiresAt`) plus small slack, capped at 300 seconds
  
  **Request Body:**
  - `authAttemptId` (required): Authentication attempt ID from login response
  - `challengeCode` (required): 6-digit challenge code from login response
  
  **Response (200 OK) - Success:**
  - `success`: true
  - `token`: Bearer token for authenticated API requests
  - `adminType`: Type of administrator
  - `username`: Administrator username
  - `expiresAt`: Token expiration timestamp
  - `message`: "Authentication successful"
  
  **Non-Blocking Flow (nonBlocking=true in login):**
  - Provides only authAttemptId from login response
  - Omit `challengeCode` only when the auth attempt was created without challenge
  - Long-running HTTP wait (same capped window as challenge flow; not a fixed five minutes)
  
  **Request Body:**
  - `authAttemptId` (required): Authentication attempt ID from login response
  - `challengeCode` (optional): Omit this field for non-blocking flow
  
  **Response (200 OK) - Success:**
  - `success`: true
  - `token`: Bearer token for authenticated API requests
  - `adminType`: Type of administrator
  - `username`: Administrator username
  - `expiresAt`: Token expiration timestamp
  - `message`: "Authentication successful"
  
  **Failure Response (403 Forbidden):**
  - `success`: false
  - `message`: Error description (e.g., "Authentication rejected", "Challenge code mismatch")
  
  **Failure Response (400 Bad Request):**
  - `success`: false
  - `message`: Invalid request (e.g., "Invalid authAttemptId")
  
  **Status Codes:**
  - 200: Authentication successful
  - 400: Invalid request
  - 403: Authentication failed (rejected, timeout, invalid challenge)
  - 500: Internal server error
  
  **Security Notes:**
  - Challenge Flow: The challengeCode acts as proof of legitimacy, preventing enumeration attacks
  - Non-Blocking Flow: Server accepts omitted challengeCode only for attempts created without challenge
}
