meta {
  name: passwordless-cancel
  type: http
  seq: 3
}

post {
  url: {{base_url_admin_api}}/api/v1/admin/auth/passwordless-cancel
  body: json
  auth: inherit
}

body:json {
  {
    "authAttemptId": {{authAttemptId}},
    "waiterSecret": "{{waiterSecret}}"
  }
}

script:post-response {
  test("Status code is 204, 401, or 429", function () {
      expect([204, 401, 429]).to.include(res.getStatus());
  });
}

settings {
  encodeUrl: true
}

docs {
  Cancels a pending passwordless login attempt using the waiter secret from /login (#831).

  Marks the auth attempt EXPIRED so in-flight passwordless-wait unblocks and an immediate
  retry is not blocked by a dangling PENDING attempt.

  **Request Body:**
  - `authAttemptId` (required): Authentication attempt ID from login response
  - `waiterSecret` (required): One-time waiter secret from login response

  **Status Codes:**
  - 204: Cancelled (or already final — idempotent)
  - 401: Missing or invalid waiter secret
  - 429: Rate limited (shares passwordless-wait bucket)
  - 500: Internal server error

  **Security Notes:**
  - Public (no bearer); gated by waiter secret issued only to the login client
  - Does not accept challengeCode (cancel is independent of challenge mode)
}
