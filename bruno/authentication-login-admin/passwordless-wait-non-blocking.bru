meta {
  name: passwordless-wait (non-blocking)
  type: http
  seq: 3
}

post {
  url: {{base_url_admin_api}}/api/v1/admin/auth/passwordless-wait
  body: json
  auth: inherit
}

body:json {
  {
    "authAttemptId": {{authAttemptId}}
  }
  
}

script:post-response {
  test("Status code is 200, 403, or 400", function () {
      expect([200, 403, 400]).to.include(res.getStatus());
  });
  
  if (res.getStatus() === 200) {
      var jsonData = res.getBody();
      
      if (jsonData.success === true) {
          bru.setEnvVar("token", jsonData.token);
          
          // Extract multi-tenancy fields (Phase 1)
          if (jsonData.adminType) {
              bru.setEnvVar("adminType", jsonData.adminType);
          }
          if (jsonData.tenantId !== undefined && jsonData.tenantId !== null) {
              bru.setEnvVar("tenantId", jsonData.tenantId.toString());
          }
          
          test("Response contains token", function () {
              expect(jsonData).to.have.property('token');
              expect(jsonData.token).to.be.a('string');
          });
      }
  }
}

settings {
  encodeUrl: true
}

docs {
  Waits for device approval in the non-blocking passwordless authentication flow.
  
  **Usage:** This request is used when the login call has nonBlocking=true. The /login endpoint returns only authAttemptId (no challengeCode), and this endpoint completes the authentication by waiting for the device response.
  
  **Key Differences from Challenge Flow:**
  - No challengeCode in request (omit the field entirely)
  - Valid only for attempts that were created without challenge
  - Used for responsive UI patterns where client shows countdown timer and polls for completion
  
  **Request Body:**
  - `authAttemptId` (required): Authentication attempt ID from login response
  
  **Response (200 OK) - Success:**
  - `success`: true
  - `token`: Bearer token for authenticated API requests
  - `adminType`: Type of administrator
  - `username`: Administrator username
  - `expiresAt`: Token expiration timestamp
  - `message`: "Authentication successful"
  
  **Failure Response (403 Forbidden):**
  - `success`: false
  - `message`: Error description (e.g., "Authentication rejected", "Device timeout")
  
  **Failure Response (400 Bad Request):**
  - `success`: false
  - `message`: Invalid request (e.g., "Invalid authAttemptId")
  
  **Status Codes:**
  - 200: Authentication successful or failure (check success field)
  - 400: Invalid request
  - 403: Authentication failed
  - 500: Internal server error
  
  **Typical client flow (non-blocking):**
  After login with nonBlocking=true:
  ```
  1. Client receives authAttemptId and expiresAt from /login
  2. Client shows countdown from expiresAt (matches DB attempt expiry)
  3. Client issues a single long-running POST to /passwordless-wait (server polls DB until approval, expiry, or wait cap)
  4. On success=true, store bearer token
  ```
}
