# Ezkey - Git Line Ending Configuration
# Forces LF line endings for all text files per Google Java Style Guide

# Auto-detect text files and normalize to LF
* text=auto eol=lf

# Java source files: LF
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# SQL files: LF
*.sql text eol=lf

# Configuration files: LF
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Windows batch files: CRLF (exception)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: no conversion
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
