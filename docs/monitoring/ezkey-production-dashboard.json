      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "ezkey-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  COALESCE(i18n.integration_i18n_name, 'Integration ' || i.integration_id) as \"Integration Name\",\n  COUNT(e.enrollment_id) as \"Total Enrollments\",\n  COUNT(CASE WHEN e.enrollment_active = true THEN 1 END) as \"Active Enrollments\",\n  COUNT(CASE WHEN e.enrollment_valid = true THEN 1 END) as \"Valid Enrollments\",\n  CASE \n    WHEN COUNT(e.enrollment_id) = 0 THEN 0\n    ELSE ROUND(COUNT(CASE WHEN e.enrollment_active = true THEN 1 END) * 100.0 / COUNT(e.enrollment_id), 1)\n  END as \"Active %\"\nFROM ezkey_integration i\nLEFT JOIN ezkey_enrollment e ON i.integration_id = e.integration_id\nLEFT JOIN ezkey_integration_i18n i18n ON i.integration_id = i18n.integration_id AND i18n.integration_i18n_lang = 'en'\nWHERE i.integration_active = true\nGROUP BY i.integration_id, i18n.integration_i18n_name\nORDER BY \"Total Enrollments\" DESC",
          "refId": "A"
        }
      ],
      "title": "Enrollments by Integration",
      "type": "table"
    },
