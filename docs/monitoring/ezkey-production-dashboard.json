          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  date_trunc('hour', created_at) as time,\n  COUNT(CASE WHEN auth_attempt_accepted = true THEN 1 END) as \"Successful\",\n  COUNT(CASE WHEN auth_attempt_responded = true AND auth_attempt_accepted = false THEN 1 END) as \"Denied\",\n  COUNT(CASE WHEN auth_attempt_responded = false AND expires_at < NOW() THEN 1 END) as \"Expired\",\n  COUNT(CASE WHEN auth_attempt_responded = false AND expires_at >= NOW() THEN 1 END) as \"Pending\"\nFROM ezkey_auth_attempt\nWHERE created_at >= NOW() - INTERVAL '24 hours'\nGROUP BY date_trunc('hour', created_at)\nORDER BY time",
