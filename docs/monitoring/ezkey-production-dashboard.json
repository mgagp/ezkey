          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  'Valid & Active' as status,\n  COUNT(*) as count\nFROM ezkey_enrollment \nWHERE enrollment_valid = true AND enrollment_active = true\nUNION ALL\nSELECT \n  'Valid but Inactive' as status,\n  COUNT(*) as count\nFROM ezkey_enrollment \nWHERE enrollment_valid = true AND enrollment_active = false\nUNION ALL\nSELECT \n  'Invalid' as status,\n  COUNT(*) as count\nFROM ezkey_enrollment \nWHERE enrollment_valid = false",
          "refId": "A"
        }
      ],
      "title": "Enrollment Status Distribution",
      "type": "piechart"
