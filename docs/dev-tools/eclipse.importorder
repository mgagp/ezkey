# Eclipse Import Order File
# Generated by GitHub Copilot
#
# This file configures the import order to be compatible with the Google Java Style Guide
# and the project's Checkstyle rules.
#
# To import into Eclipse:
# 1. Go to Window > Preferences
# 2. Navigate to Java > Code Style > Organize Imports
# 3. Click "Import..." and select this file.
#
# The order is:
# 1. All static imports (grouped together)
# 2. A blank line
# 3. All non-static imports (grouped together)

org.eclipse.jdt.ui.importorder=static *;*
org.eclipse.jdt.ui.ondemandthreshold=99
org.eclipse.jdt.ui.staticondemandthreshold=99
org.eclipse.jdt.ui.staticimports.separate=true
