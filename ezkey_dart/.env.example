# Optional overrides for bin/ezkey_e2e.dart (`--env-file .env`). Copy to `.env` (gitignored).
# Defaults are the Docker service hostnames on the stack network (ezkey_ezkey-network).
# EZKEY_AUTH_API_URL=http://auth-api:8080
# EZKEY_ADMIN_API_URL=http://admin-api:9080
# EZKEY_INTEGRATION_API_URL=http://integration-api:7080
# EZKEY_CRYPTO_API_URL=http://crypto-api:9090
