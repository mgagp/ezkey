{
  "name": "logout",
  "request": {
    "type": "http",
    "url": "{{base_url_admin_api}}/api/v1/admin/auth/logout",
    "scripts": {
      "preRequest": "",
      "postResponse": "var jsonData = JSON.parse(rq.response.text());\r\nrq.environment.set(\"token\", jsonData.token);"
    },
    "method": "POST",
    "queryParams": [],
    "headers": [],
    "body": null,
    "bodyContainer": {},
    "contentType": "text/plain",
    "auth": {
      "currentAuthType": "BEARER_TOKEN",
      "authConfigStore": {
        "BEARER_TOKEN": {
          "bearer": "{{token}}"
        }
      }
    }
  }
}