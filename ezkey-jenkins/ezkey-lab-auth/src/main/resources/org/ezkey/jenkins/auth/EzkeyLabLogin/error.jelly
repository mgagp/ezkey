<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <l:layout title="Ezkey login — Error" norefresh="true">
    <l:main-panel>
      <div data-testid="ezkey-lab-state" data-ezkey-lab-state="error">
        <p style="margin:0 0 0.5rem;color:#666;font-size:0.9rem;">State: Error</p>
        <h1>Ezkey login</h1>
        <p data-testid="ezkey-lab-error">${it.errorMessage}</p>
        <p><a href=".">Back</a> · <a href="${rootURL}/login">Jenkins login</a></p>
      </div>
    </l:main-panel>
  </l:layout>
</j:jelly>
