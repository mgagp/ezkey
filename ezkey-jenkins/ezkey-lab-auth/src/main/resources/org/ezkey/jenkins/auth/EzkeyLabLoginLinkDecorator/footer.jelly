<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core">
  <j:if test="${app.securityRealm.class.name == 'org.ezkey.jenkins.auth.EzkeyMockSecurityRealm'}">
    <div style="text-align:center;margin:1rem 0;" data-testid="ezkey-lab-login-link">
      <a href="${rootURL}/ezkey-lab-login/">Sign in with Ezkey MFA (lab)</a>
    </div>
  </j:if>
</j:jelly>
