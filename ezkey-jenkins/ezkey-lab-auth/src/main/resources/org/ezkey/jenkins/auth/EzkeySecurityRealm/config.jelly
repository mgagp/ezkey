<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:section title="Ezkey Integration API">
    <f:entry title="Integration API base URL" field="ezkeyBaseUrl">
      <f:textbox/>
    </f:entry>
    <f:entry title="Integration key" field="integrationKey">
      <f:textbox/>
    </f:entry>
    <f:entry title="Integration secret" field="ezkeySecret">
      <f:password/>
    </f:entry>
    <f:entry title="Require a challenge code" field="forceChallenge">
      <f:checkbox default="true"/>
    </f:entry>
  </f:section>
  <f:section title="Ezkey-enabled users">
    <f:entry title="Users" field="enabledUsers">
      <f:repeatable field="enabledUsers" var="account" items="${instance.enabledUsers}" noAddButton="false" minimum="0">
        <f:entry title="Jenkins username" field="username">
          <f:textbox value="${account.username}"/>
        </f:entry>
        <f:entry title="Ezkey user identifier (optional)" field="userIdentifier">
          <f:textbox value="${account.userIdentifier}"/>
        </f:entry>
        <f:repeatableDeleteButton/>
      </f:repeatable>
    </f:entry>
  </f:section>
  <f:section title="Break-glass admin">
    <f:entry title="Break-glass username" field="breakGlassUsername">
      <f:textbox default="admin"/>
    </f:entry>
    <f:entry title="Break-glass password" field="breakGlassPassword">
      <f:password/>
    </f:entry>
  </f:section>
</j:jelly>
