			"name": "login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = JSON.parse(pm.response.text());\r",
							"pm.environment.set(\"token\", jsonData.token);\r",
							"pm.environment.set(\"tempToken\", jsonData.tempToken);\r",
							"pm.environment.set(\"authAttemptId\", jsonData.authAttemptId);\r",
							"pm.environment.set(\"challengeCode\", jsonData.challengeCode);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"username\": \"admin\",\r\n    \"authMode\": \"ezkey\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url_admin_api}}/api/v1/admin/auth/login",
