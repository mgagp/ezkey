			"name": "1 crypto generate device proof token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = JSON.parse(pm.response.text());\r",
							"pm.environment.set(\"device_proofToken\", jsonData.proofToken);\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url_crypto_api}}/api/v1/crypto/prooftoken",
					"host": [
						"{{base_url_crypto_api}}"
					],
					"path": [
						"api",
						"v1",
						"crypto",
						"prooftoken"
					]
				}
			},
			"response": []
