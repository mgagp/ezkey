{
	"info": {
		"_postman_id": "633c8fa1-be1d-47da-ba89-79304eb68eb2",
		"name": "EZ Key API Keys admin",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "4087"
	},
	"item": [
		{
			"name": "create",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = JSON.parse(pm.response.text());\r",
							"pm.environment.set(\"apiKeyId\", jsonData.apiKeyId);\r",
							"pm.environment.set(\"integrationKey\", jsonData.integrationKey);\r",
							"pm.environment.set(\"secretKey\", jsonData.secretKey);\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"integrationId\": {{integrationId}},\r\n  \"description\": \"Fritte Server API Key\",\r\n  \"expiresAt\": \"2025-12-31T23:59:59Z\",\r\n  \"ipWhitelist\": [\r\n    \"192.168.1.0/24\",\r\n    \"10.0.0.100\",\r\n    \"0:0:0:0:0:0:0:1\"\r\n  ]\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url_admin_api}}/api/v1/api-keys",
					"host": [
						"{{base_url_admin_api}}"
					],
					"path": [
						"api",
						"v1",
						"api-keys"
					]
				}
			},
			"response": []
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"requests": {},
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"requests": {},
				"exec": [
					""
				]
			}
		}
	]
}