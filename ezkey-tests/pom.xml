<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.ezkey</groupId>
    <artifactId>ezkey-parent</artifactId>
    <version>${revision}${buildQualifier}${changelist}</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>ezkey-tests</artifactId>
  <name>Ezkey Functional Tests</name>
  <description>Real-world security end-to-end functional tests using RestAssured against Docker stack</description>

  <properties>
    <rest-assured.version>6.0.0</rest-assured.version>
    <assertj.version>3.27.7</assertj.version>
  </properties>

  <dependencies>
    <!-- Functional tests are independent and test APIs via HTTP only -->
    <!-- No direct dependency on admin-api or auth-api implementations -->

    <!-- Spring Boot Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- RestAssured for API testing -->
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <version>${rest-assured.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>json-path</artifactId>
      <version>${rest-assured.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>xml-path</artifactId>
      <version>${rest-assured.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- AssertJ for fluent assertions -->
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Jackson 2 databind for test helper JSON (standalone HTTP tests; not the Boot 4 Jackson 3 stack) -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
      </testResource>
    </testResources>

    <plugins>
      <!-- Maven Surefire Plugin for running tests -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
          </includes>
          <!-- Default: exclude slow, time-dependent, elective, operational churn, and churn init -->
          <excludedGroups>slow,time-dependent,elective,operational-churn,operational-churn-init</excludedGroups>
          <systemPropertyVariables>
            <!-- Anchors .ezkey-test/ to this module's basedir regardless of the shell cwd.
                 Prevents stale-cache cross-contamination when running from a worktree or a
                 different working directory than ezkey-tests/. -->
            <ezkey.test.state.dir>${project.basedir}/.ezkey-test</ezkey.test.state.dir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!--
    Test Execution Profiles
    =======================
    Use these profiles to control which tests run:

    Default (no profile):
      mvn test -pl ezkey-tests
      Runs: fast tests only (excludes slow, time-dependent)
      Use case: CI on every commit, quick local validation

    slow-tests:
      mvn test -pl ezkey-tests -P slow-tests
      Runs: slow tests only
      Use case: Nightly builds, pre-release validation

    all-tests:
      mvn test -pl ezkey-tests -P all-tests
      Runs: ALL tests (no filtering)
      Use case: Full validation before release

    smoke-tests:
      mvn test -pl ezkey-tests -P smoke-tests
      Runs: smoke tests only
      Use case: Quick sanity check, post-deployment validation

    Ad-hoc filtering (without profiles):
      mvn test -pl ezkey-tests -Dgroups="encryption"
      mvn test -pl ezkey-tests -DexcludedGroups="time-dependent"

    operational-churn-tests:
      mvn test -pl ezkey-tests -P operational-churn-tests
      Or: ./ezkey-tests/scripts/run-operational-churn.sh (see docs/plan/operational-churn-ezkey.plan.md)

    operational-churn-init (once per environment — peer Global Admin + state file):
      mvn test -pl ezkey-tests -P operational-churn-init
      Or: ./ezkey-tests/scripts/run-operational-churn.sh with the init flag
  -->
  <profiles>
    <!-- Slow tests only (nightly, pre-release) -->
    <profile>
      <id>slow-tests</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <groups>slow</groups>
              <excludedGroups combine.self="override"></excludedGroups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- All tests (full validation) -->
    <profile>
      <id>all-tests</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <!-- No groups filter = run all standard tests; elective always excluded -->
              <groups combine.self="override"></groups>
              <excludedGroups>elective,operational-churn,operational-churn-init</excludedGroups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Smoke tests only (quick validation) -->
    <profile>
      <id>smoke-tests</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <groups>smoke</groups>
              <excludedGroups combine.self="override"></excludedGroups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Time-dependent tests only (for debugging timing issues) -->
    <profile>
      <id>time-dependent-tests</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <groups>time-dependent</groups>
              <excludedGroups combine.self="override"></excludedGroups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Encryption-related tests only -->
    <profile>
      <id>encryption-tests</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <groups>encryption</groups>
              <excludedGroups combine.self="override"></excludedGroups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Operational churn: sustained tenant + enrollment + auth loops (manual / QA; not default CI) -->
    <profile>
      <id>operational-churn-tests</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <groups>operational-churn</groups>
              <excludedGroups combine.self="override"></excludedGroups>
              <forkCount>1</forkCount>
              <reuseForks>false</reuseForks>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- One-shot: provision peer Global Admin for operational churn (writes .ezkey-test state file) -->
    <profile>
      <id>operational-churn-init</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <groups>operational-churn-init</groups>
              <excludedGroups combine.self="override"></excludedGroups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Elective on-demand spot-check tests (never run automatically) -->
    <profile>
      <id>elective-tests</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <groups>elective</groups>
              <excludedGroups combine.self="override"></excludedGroups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
