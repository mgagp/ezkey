<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.ezkey</groupId>
    <artifactId>ezkey-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>ezkey-tests</artifactId>
  <name>Ezkey Functional Tests</name>
  <description>Real-world security end-to-end functional tests using RestAssured against Docker stack</description>

  <properties>
    <rest-assured.version>6.0.0</rest-assured.version>
    <assertj.version>3.24.2</assertj.version>
  </properties>

  <dependencies>
    <!-- Functional tests are independent and test APIs via HTTP only -->
    <!-- No direct dependency on admin-api or auth-api implementations -->

    <!-- Spring Boot Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- RestAssured for API testing -->
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <version>${rest-assured.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>json-path</artifactId>
      <version>${rest-assured.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>xml-path</artifactId>
      <version>${rest-assured.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- AssertJ for fluent assertions -->
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Jackson for JSON processing -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
      </testResource>
    </testResources>

    <plugins>
      <!-- Maven Surefire Plugin for running tests -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
          </includes>
          <!-- Default: exclude slow and time-dependent tests for fast feedback -->
          <excludedGroups>slow,time-dependent</excludedGroups>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!--
    Test Execution Profiles
    =======================
    Use these profiles to control which tests run:

    Default (no profile):
      mvn test -pl ezkey-tests
      Runs: fast tests only (excludes slow, time-dependent)
      Use case: CI on every commit, quick local validation

    slow-tests:
      mvn test -pl ezkey-tests -P slow-tests
      Runs: slow tests only
      Use case: Nightly builds, pre-release validation

    all-tests:
      mvn test -pl ezkey-tests -P all-tests
      Runs: ALL tests (no filtering)
      Use case: Full validation before release

    smoke-tests:
      mvn test -pl ezkey-tests -P smoke-tests
      Runs: smoke tests only
      Use case: Quick sanity check, post-deployment validation

    Ad-hoc filtering (without profiles):
      mvn test -pl ezkey-tests -Dgroups="encryption"
      mvn test -pl ezkey-tests -DexcludedGroups="time-dependent"
  -->
  <profiles>
    <!-- Slow tests only (nightly, pre-release) -->
    <profile>
      <id>slow-tests</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <groups>slow</groups>
              <excludedGroups combine.self="override"></excludedGroups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- All tests (full validation) -->
    <profile>
      <id>all-tests</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <!-- No groups filter = run all tests -->
              <groups combine.self="override"></groups>
              <excludedGroups combine.self="override"></excludedGroups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Smoke tests only (quick validation) -->
    <profile>
      <id>smoke-tests</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <groups>smoke</groups>
              <excludedGroups combine.self="override"></excludedGroups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Time-dependent tests only (for debugging timing issues) -->
    <profile>
      <id>time-dependent-tests</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <groups>time-dependent</groups>
              <excludedGroups combine.self="override"></excludedGroups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Encryption-related tests only -->
    <profile>
      <id>encryption-tests</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <groups>encryption</groups>
              <excludedGroups combine.self="override"></excludedGroups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
