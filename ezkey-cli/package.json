{
  "name": "ezkey-cli",
  "version": "1.0.0",
  "description": "Command line interface for Ezkey - Open Source MFA/Passkey Alternative",
  "main": "dist/index.js",
  "bin": {
    "ezkey": "./bin/ezkey"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "ezkey",
    "mfa",
    "authentication", 
    "cli",
    "command-line"
  ],
  "author": "Ezkey contributors",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.1.0",
    "axios": "^1.6.2",
    "chalk": "^4.1.2",
    "inquirer": "^8.2.6"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/inquirer": "^8.2.10",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mgagp/ezkey.git",
    "directory": "ezkey-cli"
  }
}