# Ezkey Docker Environment Configuration
# This file will be automatically loaded by docker-compose

# Database Configuration
POSTGRES_DB=ezkey_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ezkey
DB_HOST=ezkey-postgres
DB_PORT=5432

# Application Ports
EZKEY_ADMIN_API_PORT=9080
EZKEY_AUTH_API_PORT=8080
EZKEY_SIM_API_PORT=8081
EZKEY_DEMO_ACME_PORT=8082
EZKEY_DEMO_DEVICE_PORT=8083

# Database Connection URL
DATABASE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${POSTGRES_DB}

# Application Configuration
JAVA_OPTS=-Xms256m -Xmx512m
SPRING_PROFILES_ACTIVE=docker

# Logging Configuration
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_EZKEY=DEBUG

# Security Configuration
EZKEY_AUTH_TTL_SECONDS=120

# Demo Application Configuration
DEMO_ACME_ADMIN_API_URL=http://ezkey-admin-api:9080
DEMO_DEVICE_AUTH_API_URL=http://ezkey-auth-api:8080