{
  "name": "ezkey-mobile",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@4.10.3",
  "scripts": {
    "android": "npx react-native run-android",
    "android:jdk17": "bash scripts/android-with-jdk17.sh",
    "ios": "npx react-native run-ios",
    "start": "npx react-native start",
    "generate:api": "orval --config orval.config.ts",
    "android:clean": "cd android && ./gradlew clean",
    "android:assemble:debug": "cd android && ./gradlew assembleDebug",
    "android:install:debug": "cd android && ./gradlew installDebug",
    "android:assemble:release": "cd android && ./gradlew assembleRelease",
    "android:bundle:release": "cd android && ./gradlew bundleRelease",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "yarn lint --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "validate": "yarn lint && yarn typecheck && yarn test",
    "validate:ci": "yarn lint && yarn typecheck && yarn test --runInBand",
    "hooks:install": "git config core.hooksPath ezkey_mobile/.husky",
    "license:check": "node scripts/check-third-party-licenses.mjs",
    "license:generate": "npx @rnx-kit/third-party-notices --output third-party-notices.txt && node scripts/generate-third-party-licenses.mjs",
    "license:app-data": "node scripts/generate-third-party-licenses.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.0.2",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/native": "7.2.2",
    "@react-navigation/native-stack": "7.14.12",
    "@react-navigation/stack": "7.8.11",
    "@tanstack/react-query": "5.100.7",
    "axios": "1.15.2",
    "i18next": "26.0.8",
    "js-sha256": "0.11.1",
    "react": "19.2.3",
    "react-i18next": "17.0.6",
    "react-native": "0.85.3",
    "react-native-config": "1.6.1",
    "react-native-gesture-handler": "2.31.1",
    "react-native-keychain": "10.0.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.24.0",
    "react-native-svg": "15.15.4",
    "react-native-vision-camera": "4.7.2",
    "react-native-worklets-core": "1.6.3",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/plugin-proposal-nullish-coalescing-operator": "7.18.6",
    "@babel/plugin-proposal-optional-chaining": "7.21.0",
    "@babel/plugin-transform-arrow-functions": "7.27.1",
    "@babel/plugin-transform-shorthand-properties": "7.27.1",
    "@babel/plugin-transform-template-literals": "7.27.1",
    "@babel/preset-typescript": "7.28.5",
    "@babel/runtime": "7.28.4",
    "@react-native-community/cli": "20.1.3",
    "@react-native-community/cli-platform-android": "20.1.3",
    "@react-native-community/cli-platform-ios": "20.1.3",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@react-native/typescript-config": "0.85.3",
    "@rnx-kit/third-party-notices": "2.0.2",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.14",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "lint-staged": "16.4.0",
    "orval": "8.9.0",
    "prettier": "3.8.3",
    "react-native-svg-transformer": "1.5.3",
    "react-test-renderer": "19.2.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "yarn lint --fix --max-warnings=0",
      "yarn format"
    ],
    "*.{json,md,yml,yaml}": "yarn format"
  }
}
