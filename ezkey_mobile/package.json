{
  "name": "ezkey-mobile",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@4.10.3",
  "scripts": {
    "android": "npx react-native run-android",
    "android:jdk17": "bash scripts/android-with-jdk17.sh",
    "ios": "npx react-native run-ios",
    "start": "npx react-native start",
    "generate:api": "orval --config orval.config.ts",
    "deps:monitor": "node scripts/dependency-monitor.mjs",
    "deps:monitor:strict": "node scripts/dependency-monitor.mjs --strict",
    "deps:monitor:history": "node scripts/dependency-monitor.mjs --history",
    "deps:monitor:history:strict": "node scripts/dependency-monitor.mjs --history --strict",
    "doctor:curated": "node scripts/mobile-doctor-curated.mjs",
    "quality:curate": "node scripts/code-quality-curator.mjs",
    "quality:curate:md": "node scripts/code-quality-curator.mjs --format=md",
    "quality:curate:html": "node scripts/code-quality-curator.mjs --format=html",
    "quality:semgrep:scan": "node scripts/semgrep-scan.mjs",
    "quality:semgrep:report": "node scripts/code-quality-curator.mjs --inputs=.monitor/semgrep-report.json --report-name=iteration2-semgrep --top=30",
    "quality:detekt:scan": "node scripts/detekt-scan.mjs",
    "quality:detekt:report": "node scripts/code-quality-curator.mjs --inputs=.monitor/detekt.sarif --report-name=iteration4-detekt --top=30",
    "quality:pipeline": "node scripts/mobile-doctor-curated.mjs",
    "quality:pipeline:report": "node scripts/mobile-doctor-curated.mjs",
    "android:preflight:path": "bash scripts/preflight-android-path-length.sh",
    "android:clean": "cd android && ./gradlew clean",
    "android:assemble:debug": "cd android && ./gradlew assembleDebug",
    "android:install:debug": "cd android && ./gradlew installDebug",
    "android:install:debug:clean": "bash scripts/build-install-debug-clean.sh",
    "android:assemble:release": "cd android && ./gradlew assembleRelease",
    "android:bundle:release": "cd android && ./gradlew bundleRelease",
    "lint": "eslint .",
    "lint:fix": "yarn lint --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "validate": "yarn lint && yarn typecheck && yarn test",
    "validate:ci": "yarn lint && yarn typecheck && yarn test --runInBand",
    "hooks:install": "git config core.hooksPath ezkey_mobile/.husky",
    "license:check": "node scripts/check-third-party-licenses.mjs",
    "license:generate": "npx @rnx-kit/third-party-notices --output third-party-notices.txt && node scripts/generate-third-party-licenses.mjs",
    "license:app-data": "node scripts/generate-third-party-licenses.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/native": "7.3.9",
    "@react-navigation/native-stack": "7.18.1",
    "@react-navigation/stack": "7.10.12",
    "@tanstack/react-query": "5.101.2",
    "axios": "1.18.1",
    "i18next": "26.3.6",
    "js-sha256": "0.11.1",
    "react": "19.2.7",
    "react-i18next": "17.0.10",
    "react-native": "0.86.0",
    "react-native-config": "1.6.1",
    "react-native-gesture-handler": "3.0.2",
    "react-native-keychain": "10.0.0",
    "react-native-nitro-image": "0.15.1",
    "react-native-nitro-modules": "0.36.1",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.5",
    "react-native-vision-camera": "5.1.0",
    "react-native-vision-camera-barcode-scanner": "5.1.0",
    "react-native-vision-camera-worklets": "5.1.0",
    "react-native-worklets": "0.11.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/runtime": "8.0.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@rnx-kit/third-party-notices": "3.0.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.17",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "lint-staged": "17.0.8",
    "orval": "8.22.0",
    "prettier": "3.9.5",
    "react-native-svg-transformer": "1.5.3",
    "react-test-renderer": "19.2.7",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "yarn lint --fix --max-warnings=0",
      "yarn format"
    ],
    "*.{json,md,yml,yaml}": "yarn format"
  }
}
