{
  "name": "ezkey-mobile",
  "version": "0.0.1",
  "private": true,
  "packageManager": "yarn@4.10.3",
  "scripts": {
    "android": "npx react-native run-android",
    "android:jdk17": "bash scripts/android-with-jdk17.sh",
    "ios": "npx react-native run-ios",
    "start": "npx react-native start",
    "android:clean": "cd android && ./gradlew clean",
    "android:assemble:debug": "cd android && ./gradlew assembleDebug",
    "android:install:debug": "cd android && ./gradlew installDebug",
    "android:assemble:release": "cd android && ./gradlew assembleRelease",
    "android:bundle:release": "cd android && ./gradlew bundleRelease",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "yarn lint --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "validate": "yarn lint && yarn typecheck && yarn test",
    "hooks:install": "git config core.hooksPath ezkey_mobile/.husky",
    "license:check": "license-checker --summary",
    "license:generate": "npx @rnx-kit/third-party-notices --output third-party-notices.txt && npx license-checker --csv > THIRD-PARTY-LICENSES.txt"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-navigation/native": "^7.1.19",
    "@react-navigation/native-stack": "^7.1.19",
    "@react-navigation/stack": "^7.6.2",
    "@tanstack/react-query": "^5.90.7",
    "axios": "^1.13.2",
    "react": "18.3.1",
    "react-native": "0.76.0",
    "react-native-config": "^1.5.9",
    "react-native-gesture-handler": "2.14.1",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "3.30.1",
    "react-native-vision-camera": "^4.2.3",
    "react-native-worklets-core": "^1.6.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.0-alpha.2",
    "@react-native-community/cli-platform-android": "15.0.0-alpha.2",
    "@react-native-community/cli-platform-ios": "15.0.0-alpha.2",
    "@react-native/babel-preset": "0.76.0",
    "@react-native/eslint-config": "0.76.0",
    "@react-native/metro-config": "0.76.0",
    "@react-native/typescript-config": "0.76.0",
    "@rnx-kit/third-party-notices": "^2.0.2",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "license-checker": "^25.0.1",
    "lint-staged": "^16.2.6",
    "prettier": "^3.3.3",
    "react-test-renderer": "18.3.1",
    "typescript": "5.4.5"
  },
  "engines": {
    "node": ">=18"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "yarn lint --fix --max-warnings=0",
      "yarn format"
    ],
    "*.{json,md,yml,yaml}": "yarn format"
  }
}
