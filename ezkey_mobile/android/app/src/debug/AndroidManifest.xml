<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
    react-android's debug manifest adds ACCESS_LOCAL_NETWORK (Android 17) to reach Metro over the
    LAN. Our debug APK bundles its JS (ezkey.useMetroInDebug=false) and Metro goes through
    `adb reverse` (loopback, exempt), so the runtime "nearby devices" prompt only blocked Maestro
    flows. Removed so debug asks for the same permissions as release (#1175).
    -->
    <uses-permission
        android:name="android.permission.ACCESS_LOCAL_NETWORK"
        tools:node="remove" />

    <application
        android:usesCleartextTraffic="true"
        tools:targetApi="28"
        tools:ignore="GoogleAppIndexingWarning"/>
</manifest>
