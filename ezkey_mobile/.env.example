# Public Auth API base URL (scheme + host + port). Use enrollment QR with authUrl when the server
# sets ezkey.qr.auth-base-url, or set this for manual entry / legacy pipe QR.
EZKEY_API_BASE_URL=http://127.0.0.1:8080
EZKEY_REQUEST_TIMEOUT=10000

# When true, show the technical "Debug (for support)" box on Pending auth errors (hashes, steps).
# Default false. Requires a native rebuild after changing react-native-config values.
EZKEY_PENDING_AUTH_DEBUG_PANEL=false

# --- Hypothesis-validation (Maestro pilot); remove when no longer needed ---
# When true, console logs [PendingAuthRespond] … steps inside handleRespond (timing / Maestro diagnosis).
# No challenge digits or proof tokens. Requires a native rebuild after changing react-native-config values.
EZKEY_PENDING_AUTH_FLOW_TRACE=false

# --- TEMP: stack modernization (#177); remove when camera/storage upgrades are done ---
