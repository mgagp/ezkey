<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.ezkey</groupId>
	<artifactId>ezkey-parent</artifactId>
	<version>${revision}${changelist}</version>
	<packaging>pom</packaging>

	<name>Ezkey Parent</name>
	<description>Ezkey - Open Source MFA/Passkey Alternative</description>
	<url>https://github.com/ezkey/ezkey</url>

	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://opensource.org/licenses/MIT</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<name>Ezkey Contributors</name>
			<email>info@ezkey.org</email>
			<organization>Ezkey Project</organization>
			<organizationUrl>https://ezkey.org</organizationUrl>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:git://github.com/ezkey/ezkey.git</connection>
		<developerConnection>scm:git:ssh://github.com:ezkey/ezkey.git</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/ezkey/ezkey</url>
	</scm>

	<!-- Modules du projet -->
	<modules>
		<module>checkstyle-config</module>
		<module>ezkey-core</module>
		<module>ezkey-core-security</module>
		<module>ezkey-migration</module>
		<module>ezkey-admin-api</module>
		<module>ezkey-auth-api</module>
		<module>ezkey-integration-api</module>
		<module>ezkey-crypto-api</module>
		<module>ezkey-sdk/java</module>
		<module>ezkey-demo-app-acme</module>
		<module>ezkey-demo-device</module>
		<module>ezkey-tests</module>
	</modules>

	<properties>
		<!--
		  Product SemVer (ADR-0017 / #1211): one version for the whole monorepo.
		  CI-friendly formula: ${revision}${changelist} → 0.2.0-SNAPSHOT in dev.
		  Release cuts clear changelist (empty) so the coordinate is 0.2.0.
		  Local branch/worktree isolation: scripts/mvn-branch.sh appends a qualifier to
		  revision (e.g. -Drevision=0.2.0-feature-x). Do not put a custom property inside
		  <version> — flatten resolveCiFriendliesOnly only expands revision/changelist/sha1.
		  npm / Android / SDK consumers sync from these properties via scripts/sync-version.sh.
		-->
		<revision>0.2.0</revision>
		<changelist>-SNAPSHOT</changelist>
		<flatten-maven-plugin.version>1.8.0</flatten-maven-plugin.version>
		<java.version>25</java.version>
		<maven.compiler.source>25</maven.compiler.source>
		<maven.compiler.target>25</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<spring-boot.version>4.1.2</spring-boot.version>
		<!-- SEC-019: targeted BOM overrides (July 2026 Security Challenge advisories).
		     postgresql / tomcat pins dropped with Boot 4.1.2 — BOM manages 42.7.14 / 11.0.27 (#1031, #939). -->
		<logback.version>1.6.6</logback.version>

		<jackson-bom.version>3.2.4</jackson-bom.version>
		<jackson-2-bom.version>2.22.4</jackson-2-bom.version>
		<mapstruct.version>1.6.3</mapstruct.version>
		<springdoc.version>3.2.0</springdoc.version>
		<!-- SpotBugs engine + Maven plugin (report-only via java-doctor-curated; not a build gate) -->
		<spotbugs.version>4.10.5</spotbugs.version>
		<spotbugs-maven-plugin.version>4.10.5.0</spotbugs-maven-plugin.version>
		<checkstyle.version>3.6.0</checkstyle.version>
		<!-- maven-pmd-plugin version (narrow ruleset under config/java-doctor/; not a build gate) -->
		<pmd.version>3.28.0</pmd.version>
		<jacoco.version>0.8.16</jacoco.version>
		<zxing.version>3.5.4</zxing.version>
		<spotless.version>3.11.0</spotless.version>
		<!-- Nested Spotless pin; Dependabot typically misses the plugin XML. Pulse in dependabot-curated. -->
		<!-- 2.0.0 (2026-10-30): new layout engine; cleanup pass on by default (Spotless 3.10.4 supports <cleanup>). -->
		<google-java-format.version>2.0.0</google-java-format.version>
		<bucket4j.version>8.22.0</bucket4j.version>
		<caffeine.version>3.3.1</caffeine.version>
		<tink.version>1.24.0</tink.version>
		<shedlock.version>7.10.1</shedlock.version>
		<javamelody.version>2.9.0</javamelody.version>
		<ipaddress.version>5.6.2</ipaddress.version>
		<license-maven-plugin.version>2.7.1</license-maven-plugin.version>
		<!-- Skip copying root THIRD-PARTY.txt into META-INF/licenses/ unless a shipped
		     server/backend module opts in (see ezkey-admin-api and siblings). -->
		<ezkey.skip.third-party.licenses.copy>true</ezkey.skip.third-party.licenses.copy>
	</properties>

	<!-- Gestion centralisée des dépendances -->
	<dependencyManagement>
		<dependencies>
			<!-- Spring Boot BOM -->
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${spring-boot.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- SEC-019: explicit overrides (imported BOM keeps its own property values).
			     postgresql + tomcat-embed-* removed: Boot 4.1.2 BOM already manages those versions. -->
			<dependency>
				<groupId>ch.qos.logback</groupId>
				<artifactId>logback-classic</artifactId>
				<version>${logback.version}</version>
			</dependency>
			<dependency>
				<groupId>ch.qos.logback</groupId>
				<artifactId>logback-core</artifactId>
				<version>${logback.version}</version>
			</dependency>

			<!-- MapStruct -->
			<dependency>
				<groupId>org.mapstruct</groupId>
				<artifactId>mapstruct</artifactId>
				<version>${mapstruct.version}</version>
			</dependency>
			<dependency>
				<groupId>org.mapstruct</groupId>
				<artifactId>mapstruct-processor</artifactId>
				<version>${mapstruct.version}</version>
			</dependency>

			<!-- SpringDoc OpenAPI -->
			<dependency>
				<groupId>org.springdoc</groupId>
				<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
				<version>${springdoc.version}</version>
			</dependency>

			<!-- ZXing QR Code -->
			<dependency>
				<groupId>com.google.zxing</groupId>
				<artifactId>core</artifactId>
				<version>${zxing.version}</version>
			</dependency>
			<dependency>
				<groupId>com.google.zxing</groupId>
				<artifactId>javase</artifactId>
				<version>${zxing.version}</version>
			</dependency>

			<!-- Rate Limiting -->
			<dependency>
				<groupId>com.bucket4j</groupId>
				<artifactId>bucket4j_jdk17-core</artifactId>
				<version>${bucket4j.version}</version>
			</dependency>
			<dependency>
				<groupId>com.github.ben-manes.caffeine</groupId>
				<artifactId>caffeine</artifactId>
				<version>${caffeine.version}</version>
			</dependency>

			<!-- Tink / ShedLock / IPAddress (same parent-pin shape as ZXing and Bucket4j) -->
			<dependency>
				<groupId>com.google.crypto.tink</groupId>
				<artifactId>tink</artifactId>
				<version>${tink.version}</version>
			</dependency>
			<dependency>
				<groupId>net.javacrumbs.shedlock</groupId>
				<artifactId>shedlock-spring</artifactId>
				<version>${shedlock.version}</version>
			</dependency>
			<dependency>
				<groupId>net.javacrumbs.shedlock</groupId>
				<artifactId>shedlock-provider-jdbc-template</artifactId>
				<version>${shedlock.version}</version>
			</dependency>
			<dependency>
				<groupId>com.github.seancfoley</groupId>
				<artifactId>ipaddress</artifactId>
				<version>${ipaddress.version}</version>
			</dependency>
			<dependency>
				<groupId>net.bull.javamelody</groupId>
				<artifactId>javamelody-spring-boot4-starter</artifactId>
				<version>${javamelody.version}</version>
			</dependency>

			<!-- Modules internes -->
			<dependency>
				<groupId>org.ezkey</groupId>
				<artifactId>ezkey-core</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.ezkey</groupId>
				<artifactId>ezkey-core-security</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.ezkey</groupId>
				<artifactId>ezkey-sdk</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- SEC-019: Jackson BOMs after spring-boot-dependencies (later import wins) -->
			<dependency>
				<groupId>tools.jackson</groupId>
				<artifactId>jackson-bom</artifactId>
				<version>${jackson-bom.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>com.fasterxml.jackson</groupId>
				<artifactId>jackson-bom</artifactId>
				<version>${jackson-2-bom.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!-- Force engine + annotations alignment: Jackson 3.2 needs annotations 2.22+
			     (JsonApplyView). Springdoc/swagger still pulls annotations 2.21 transitively;
			     Boot may leave tools.jackson-core behind the forced databind pin. -->
			<dependency>
				<groupId>tools.jackson.core</groupId>
				<artifactId>jackson-databind</artifactId>
				<version>${jackson-bom.version}</version>
			</dependency>
			<dependency>
				<groupId>tools.jackson.core</groupId>
				<artifactId>jackson-core</artifactId>
				<version>${jackson-bom.version}</version>
			</dependency>
			<dependency>
				<groupId>com.fasterxml.jackson.core</groupId>
				<artifactId>jackson-databind</artifactId>
				<version>${jackson-2-bom.version}</version>
			</dependency>
			<dependency>
				<groupId>com.fasterxml.jackson.core</groupId>
				<artifactId>jackson-annotations</artifactId>
				<!-- Annotations drop the patch digit (jackson-2-bom property jackson.version.annotations). -->
				<version>2.22</version>
			</dependency>


		</dependencies>
	</dependencyManagement>

	<!-- Configuration des plugins partagés -->
	<build>
		<pluginManagement>
			<plugins>
				<!-- Spotless Plugin (Google Java Format) -->
				<plugin>
					<groupId>com.diffplug.spotless</groupId>
					<artifactId>spotless-maven-plugin</artifactId>
					<version>${spotless.version}</version>
					<configuration>
						<java>
							<includes>
								<include>src/main/java/**/*.java</include>
								<include>src/test/java/**/*.java</include>
							</includes>
							<!-- Enforce LF line endings per Google Java Style Guide -->
							<endWithNewline/>
							<removeUnusedImports/>
							<trimTrailingWhitespace/>
							<googleJavaFormat>
								<version>${google-java-format.version}</version>
								<style>GOOGLE</style>
								<reflowLongStrings>true</reflowLongStrings>
								<formatJavadoc>true</formatJavadoc>
							</googleJavaFormat>
						</java>
					</configuration>
					<executions>
						<execution>
							<goals>
								<goal>apply</goal>
							</goals>
						</execution>
					</executions>
				</plugin>

				<!-- Checkstyle Plugin -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-checkstyle-plugin</artifactId>
					<version>${checkstyle.version}</version>

					<dependencies>
    					<dependency>
      						<groupId>com.puppycrawl.tools</groupId>
      						<artifactId>checkstyle</artifactId>
      						<version>14.4.0</version> <!-- Override default -->
    					</dependency>
						<dependency>
							<groupId>org.ezkey</groupId>
							<artifactId>checkstyle-config</artifactId>
							<version>${project.version}</version>
						</dependency>
					</dependencies>

					<configuration>
						<configLocation>checkstyle.xml</configLocation>
						<suppressionsLocation>checkstyle-suppressions.xml</suppressionsLocation>
						<suppressionsFileExpression>checkstyle.suppressions.file</suppressionsFileExpression>
						<consoleOutput>true</consoleOutput>
						<failsOnError>true</failsOnError>
						<includeTestSourceDirectory>false</includeTestSourceDirectory>
						<violationSeverity>warning</violationSeverity>
					</configuration>
					<executions>
						<execution>
							<id>validate</id>
							<phase>validate</phase>
							<goals>
								<goal>check</goal>
							</goals>
						</execution>
					</executions>
				</plugin>

				<!-- Maven Compiler Plugin -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.16.0</version>
					<configuration>
						<release>${java.version}</release>
						<parameters>true</parameters>
						<annotationProcessorPaths>
							<path>
								<groupId>org.mapstruct</groupId>
								<artifactId>mapstruct-processor</artifactId>
								<version>${mapstruct.version}</version>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>

				<!-- Maven Surefire Plugin -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.6.1</version>
					<configuration>
						<includes>
							<include>**/*Test.java</include>
							<include>**/*Tests.java</include>
						</includes>
						<excludes>
							<exclude>**/*IntegrationTest.java</exclude>
						</excludes>
					</configuration>
				</plugin>

				<!-- Maven Failsafe Plugin -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-failsafe-plugin</artifactId>
					<version>3.6.1</version>
					<configuration>
						<includes>
							<include>**/*IntegrationTest.java</include>
						</includes>
					</configuration>
					<executions>
						<execution>
							<goals>
								<goal>integration-test</goal>
								<goal>verify</goal>
							</goals>
						</execution>
					</executions>
				</plugin>

				<!-- JaCoCo Code Coverage -->
				<plugin>
					<groupId>org.jacoco</groupId>
					<artifactId>jacoco-maven-plugin</artifactId>
					<version>${jacoco.version}</version>
					<executions>
						<execution>
							<goals>
								<goal>prepare-agent</goal>
							</goals>
						</execution>
						<execution>
							<id>report</id>
							<phase>test</phase>
							<goals>
								<goal>report</goal>
							</goals>
						</execution>
					</executions>
				</plugin>

				<!-- Spring Boot Maven Plugin -->
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
					<version>${spring-boot.version}</version>
					<configuration>
						<excludes>
							<exclude>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
							</exclude>
						</excludes>
						<includes>
							<include>
								<groupId>nothing</groupId>
								<artifactId>nothing</artifactId>
							</include>
						</includes>
					</configuration>
					<executions>
						<execution>
							<goals>
								<goal>repackage</goal>
							</goals>
							<configuration>
								<layers>
									<enabled>false</enabled>
								</layers>
							</configuration>
						</execution>
					</executions>
				</plugin>

				<!-- Maven Resources Plugin — copy committed root THIRD-PARTY.txt into
				     META-INF/licenses/ for shipped JARs (opt-in via property). -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-resources-plugin</artifactId>
					<version>3.5.0</version>
					<configuration>
						<nonFilteredFileExtensions>
							<nonFilteredFileExtension>txt</nonFilteredFileExtension>
						</nonFilteredFileExtensions>
					</configuration>
					<executions>
						<execution>
							<id>copy-third-party-licenses</id>
							<phase>process-resources</phase>
							<goals>
								<goal>copy-resources</goal>
							</goals>
							<configuration>
								<skip>${ezkey.skip.third-party.licenses.copy}</skip>
								<outputDirectory>${project.build.outputDirectory}/META-INF/licenses</outputDirectory>
								<resources>
									<resource>
										<directory>${maven.multiModuleProjectDirectory}</directory>
										<includes>
											<include>THIRD-PARTY.txt</include>
										</includes>
									</resource>
								</resources>
							</configuration>
						</execution>
					</executions>
				</plugin>

				<!-- Fail closed when a shipped module opts in but root THIRD-PARTY.txt is absent
				     (e.g. Docker build forgot to COPY it). Skipped with the same property. -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-enforcer-plugin</artifactId>
					<version>3.7.0</version>
					<executions>
						<execution>
							<id>require-third-party-licenses-file</id>
							<phase>process-resources</phase>
							<goals>
								<goal>enforce</goal>
							</goals>
							<configuration>
								<skip>${ezkey.skip.third-party.licenses.copy}</skip>
								<rules>
									<requireFilesExist>
										<files>
											<file>${maven.multiModuleProjectDirectory}/THIRD-PARTY.txt</file>
											<file>${project.build.outputDirectory}/META-INF/licenses/THIRD-PARTY.txt</file>
										</files>
									</requireFilesExist>
								</rules>
							</configuration>
						</execution>
					</executions>
				</plugin>

				<!-- SpotBugs (report-only; invoked by scripts/java-doctor-curated.sh) -->
				<plugin>
					<groupId>com.github.spotbugs</groupId>
					<artifactId>spotbugs-maven-plugin</artifactId>
					<version>${spotbugs-maven-plugin.version}</version>
					<configuration>
						<failOnError>false</failOnError>
						<xmlOutput>true</xmlOutput>
						<xmlOutputDirectory>${project.build.directory}</xmlOutputDirectory>
						<effort>Default</effort>
						<threshold>Low</threshold>
						<excludeFilterFile>${maven.multiModuleProjectDirectory}/config/java-doctor/spotbugs-exclude.xml</excludeFilterFile>
					</configuration>
					<dependencies>
						<dependency>
							<groupId>com.github.spotbugs</groupId>
							<artifactId>spotbugs</artifactId>
							<version>${spotbugs.version}</version>
						</dependency>
					</dependencies>
				</plugin>

				<!-- PMD (narrow design/maintainability ruleset; report-only) -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-pmd-plugin</artifactId>
					<version>${pmd.version}</version>
					<configuration>
						<failOnViolation>false</failOnViolation>
						<printFailingErrors>true</printFailingErrors>
						<linkXRef>false</linkXRef>
						<includeTests>false</includeTests>
						<rulesets>
							<ruleset>${maven.multiModuleProjectDirectory}/config/java-doctor/pmd-ruleset.xml</ruleset>
						</rulesets>
						<excludeRoots>
							<excludeRoot>${project.build.directory}/generated-sources</excludeRoot>
						</excludeRoots>
					</configuration>
				</plugin>

			</plugins>
		</pluginManagement>

		<!-- Plugins appliqués à tous les modules -->
		<plugins>
			<!--
			  Resolve CI-friendly ${revision}/${changelist} in installed/deployed POMs
			  (ADR-0017 / #1211 step 2). flattenMode resolveCiFriendliesOnly keeps the rest of
			  the POM intact.
			-->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>flatten-maven-plugin</artifactId>
				<version>${flatten-maven-plugin.version}</version>
				<configuration>
					<updatePomFile>true</updatePomFile>
					<flattenMode>resolveCiFriendliesOnly</flattenMode>
				</configuration>
				<executions>
					<execution>
						<id>flatten</id>
						<phase>process-resources</phase>
						<goals>
							<goal>flatten</goal>
						</goals>
					</execution>
					<execution>
						<id>flatten.clean</id>
						<phase>clean</phase>
						<goals>
							<goal>clean</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
			</plugin>
			<!-- Opt-in copy of committed root THIRD-PARTY.txt → META-INF/licenses/
			     (skipped unless a shipped module sets ezkey.skip.third-party.licenses.copy=false). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
			</plugin>
			<!-- Available for explicit goals only (spotbugs:spotbugs / pmd:pmd); no lifecycle binding -->
			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-pmd-plugin</artifactId>
			</plugin>

			<plugin>
				<groupId>org.openrewrite.maven</groupId>
				<artifactId>rewrite-maven-plugin</artifactId>
				<version>6.46.1</version>
				<configuration>
					<activeStyles>
						<style>org.openrewrite.java.GoogleJavaFormat</style>
					</activeStyles>
					<exclusions>
						<exclusion>**/ezkey_mobile/**</exclusion>
						<exclusion>**/ezkey-cli-python/**</exclusion>
						<exclusion>**/ezkey-pam/**</exclusion>
						<exclusion>**/ezkey-sdk/**</exclusion>
						<exclusion>ezkey_mobile/**</exclusion>
						<exclusion>ezkey-cli-python/**</exclusion>
						<exclusion>ezkey-pam/**</exclusion>
						<exclusion>ezkey-sdk/**</exclusion>
					</exclusions>
				</configuration>
				<dependencies>
					<dependency>
						<groupId>org.openrewrite.recipe</groupId>
						<artifactId>rewrite-spring</artifactId>
						<version>6.37.1</version>
					</dependency>
				</dependencies>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!--
			Regenerate committed root THIRD-PARTY.txt. Not part of the default build —
			run explicitly: mvn -Plicenses generate-resources
			CI enforces freshness via the licenses-drift job.
		-->
		<profile>
			<id>licenses</id>
			<properties>
				<!-- Generation only — do not require checkstyle-config for this profile.
				     Plugin dependency resolution can fail before checkstyle.skip is honoured,
				     so pluginManagement below also unbinds Checkstyle (same approach as no-checkstyle). -->
				<checkstyle.skip>true</checkstyle.skip>
			</properties>
			<build>
				<pluginManagement>
					<plugins>
						<plugin>
							<groupId>org.apache.maven.plugins</groupId>
							<artifactId>maven-checkstyle-plugin</artifactId>
							<configuration>
								<skip>true</skip>
							</configuration>
							<dependencies>
								<!-- Empty: avoid resolving reactor checkstyle-config. -->
							</dependencies>
							<executions>
								<execution>
									<id>validate</id>
									<phase>none</phase>
								</execution>
							</executions>
						</plugin>
					</plugins>
				</pluginManagement>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>license-maven-plugin</artifactId>
						<version>${license-maven-plugin.version}</version>
						<!-- Aggregate goal belongs on the reactor parent only. -->
						<inherited>false</inherited>
						<configuration>
							<outputDirectory>${maven.multiModuleProjectDirectory}</outputDirectory>
							<thirdPartyFilename>THIRD-PARTY.txt</thirdPartyFilename>
							<useMissingFile>true</useMissingFile>
							<missingFile>${maven.multiModuleProjectDirectory}/src/license/THIRD-PARTY.properties</missingFile>
							<failOnMissing>true</failOnMissing>
							<sortArtifactByName>true</sortArtifactByName>
							<excludedScopes>test,provided,system</excludedScopes>
							<excludedGroups>org.ezkey</excludedGroups>
							<licenseMerges>
								<licenseMerge>Apache-2.0|The Apache Software License, Version 2.0|Apache License, Version 2.0|Apache 2.0|Apache License 2.0|Apache License, version 2.0|ASL, version 2</licenseMerge>
								<licenseMerge>MIT|MIT License|The MIT License|The MIT License (MIT)</licenseMerge>
								<licenseMerge>EPL-2.0|Eclipse Public License - v 2.0|Eclipse Public License 2.0|EPL 2.0</licenseMerge>
								<licenseMerge>EPL-1.0|Eclipse Public License - v 1.0|Eclipse Public License 1.0|EPL 1.0</licenseMerge>
								<licenseMerge>BSD-3-Clause|BSD 3-Clause|BSD 3-clause License|The BSD 3-Clause License|BSD Licence 3|BSD-3-Clause License|3-Clause BSD License|BSD 3-clause License w/nuclear disclaimer</licenseMerge>
								<licenseMerge>BSD-2-Clause|BSD 2-Clause|BSD 2-clause License|The BSD 2-Clause License|BSD Licence 2</licenseMerge>
								<licenseMerge>CDDL-1.0|CDDL|Common Development and Distribution License|CDDL License|COMMON DEVELOPMENT AND DISTRIBUTION LICENSE (CDDL) Version 1.0|CDDL 1.0</licenseMerge>
								<licenseMerge>LGPL-2.1-only|GNU Lesser General Public License, Version 2.1|LGPL 2.1|LGPL-2.1|GNU Lesser General Public License</licenseMerge>
								<licenseMerge>GPL-2.0-only|GNU General Public License, Version 2.0|GPL 2.0|GPL-2.0|GNU General Public License, version 2</licenseMerge>
								<licenseMerge>GPL-2.0-with-classpath-exception|GNU General Public License, version 2 with the GNU Classpath Exception|GPLv2+CE|GPL2 w/ CPE</licenseMerge>
								<licenseMerge>MPL-2.0|Mozilla Public License Version 2.0|MPL 2.0</licenseMerge>
								<licenseMerge>EDL-1.0|Eclipse Distribution License - v 1.0|Eclipse Distribution License v. 1.0|EDL 1.0</licenseMerge>
							</licenseMerges>
						</configuration>
						<executions>
							<execution>
								<id>aggregate-add-third-party</id>
								<phase>generate-resources</phase>
								<goals>
									<goal>aggregate-add-third-party</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!--
			Profile used for Docker image builds and other environments
			where we explicitly want to skip all Checkstyle execution.
			This keeps local Maven builds unchanged while ensuring that
			container builds are fast and do not depend on quality tooling.
		-->
		<profile>
			<id>no-checkstyle</id>
			<properties>
				<!-- Standard flag recognized by maven-checkstyle-plugin -->
				<checkstyle.skip>true</checkstyle.skip>
			</properties>
			<build>
				<pluginManagement>
					<plugins>
						<!-- Disable Checkstyle plugin completely in Docker builds -->
						<plugin>
							<groupId>org.apache.maven.plugins</groupId>
							<artifactId>maven-checkstyle-plugin</artifactId>
							<configuration>
								<skip>true</skip>
							</configuration>
							<dependencies>
								<!-- Override: Remove checkstyle-config dependency in Docker builds -->
								<!-- Empty dependencies list prevents resolution of checkstyle-config -->
							</dependencies>
							<executions>
								<execution>
									<id>validate</id>
									<phase>none</phase>
								</execution>
							</executions>
						</plugin>
					</plugins>
				</pluginManagement>
			</build>
		</profile>
	</profiles>
</project>
