{
  "name": "ezkey-javascript-sdk",
  "version": "1.0.0",
  "description": "JavaScript/TypeScript SDK for Ezkey Admin and Auth APIs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npm run clean && npm run generate && npm run compile",
    "clean": "rimraf dist generated",
    "generate": "npm run generate-admin && npm run generate-auth",
    "generate-admin": "openapi-generator-cli generate -i ../admin-api-spec.json -g typescript-fetch -o generated/admin --additional-properties=typescriptThreePlus=true,supportsES6=true,npmName=ezkey-admin-client,withoutRuntimeChecks=true",
    "generate-auth": "openapi-generator-cli generate -i ../auth-api-spec.json -g typescript-fetch -o generated/auth --additional-properties=typescriptThreePlus=true,supportsES6=true,npmName=ezkey-auth-client,withoutRuntimeChecks=true",
    "compile": "tsc",
    "demo": "node dist/demo/demo.js",
    "test": "echo \"No tests specified\" && exit 0",
    "license:check": "license-checker --summary",
    "license:generate": "license-checker --csv > THIRD-PARTY-LICENSES.txt"
  },
  "keywords": [
    "ezkey",
    "mfa",
    "authentication",
    "sdk",
    "typescript",
    "javascript"
  ],
  "author": "Ezkey Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mgagp/ezkey.git",
    "directory": "ezkey-sdk/javascript"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.34.0",
    "@types/node": "^25.9.2",
    "license-checker": "^25.0.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "dist",
    "THIRD-PARTY-LICENSES.txt",
    "LICENSE",
    "README.md"
  ]
}
