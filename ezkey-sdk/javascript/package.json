{
  "name": "ezkey-javascript-sdk",
  "version": "0.2.0-SNAPSHOT",
  "description": "JavaScript/TypeScript SDK for Ezkey: Integration API client, and generated Admin and Auth API clients",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "npm run clean && npm run generate && npm run compile",
    "clean": "rimraf dist generated",
    "generate": "npm run generate-admin && npm run generate-auth",
    "generate-admin": "openapi-generator-cli generate -i ../../specs/admin-api/openapi-spec.json -g typescript-fetch -o generated/admin --additional-properties=typescriptThreePlus=true,supportsES6=true,npmName=ezkey-admin-client,withoutRuntimeChecks=true",
    "generate-auth": "openapi-generator-cli generate -i ../../specs/auth-api/openapi-spec.json -g typescript-fetch -o generated/auth --additional-properties=typescriptThreePlus=true,supportsES6=true,npmName=ezkey-auth-client,withoutRuntimeChecks=true",
    "compile": "tsc",
    "demo": "node dist/demo/demo.js",
    "test": "node --test test/",
    "license:check": "license-checker --summary",
    "license:generate": "license-checker --csv > THIRD-PARTY-LICENSES.txt"
  },
  "keywords": [
    "ezkey",
    "mfa",
    "authentication",
    "sdk",
    "typescript",
    "javascript"
  ],
  "author": "Ezkey Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mgagp/ezkey.git",
    "directory": "ezkey-sdk/javascript"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.42.2",
    "@types/node": "^24",
    "license-checker": "^25.0.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "THIRD-PARTY-LICENSES.txt",
    "LICENSE",
    "README.md"
  ]
}
