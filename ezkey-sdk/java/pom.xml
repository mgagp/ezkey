<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.ezkey</groupId>
    <artifactId>ezkey-parent</artifactId>
    <version>${revision}${buildQualifier}${changelist}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>ezkey-sdk</artifactId>
  <name>Ezkey Java SDK</name>
  <description>Minimal zero-dependency Java SDK for Ezkey API key (machine-to-machine) authentication</description>

  <properties>
    <!-- SDK targets Java 17 for maximum compatibility while supporting records -->
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
  </properties>

  <dependencies>
    <!-- Zero compile-scope dependencies -->

    <!-- Test only -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- Override parent: SDK uses Java 17, no annotation processors needed -->
          <release>17</release>
          <annotationProcessorPaths/>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
