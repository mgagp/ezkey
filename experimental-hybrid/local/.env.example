# Copy to .env next to docker-compose.yml. URLs for local sidecar against localhost APIs
# (or point at your public community hostnames when testing hybrid Lightsail).

TZ=UTC
SPRING_PROFILES_ACTIVE=docker

# Public HTTPS URLs (no trailing slash on base path for these envs — use as in main docker stack).
# Prefer localhost when Auth/Integration run locally; use https://auth-api.ezkey.online /
# https://integration-api.ezkey.online when pointing at the community Lightsail stack.
EZKEY_AUTH_API_URL=http://localhost:8080
# Historical name: Demo ACME uses this as the Integration API base URL (M2M create/wait).
EZKEY_ADMIN_API_URL=http://localhost:7080

# Host path to a directory mirroring /etc/ezkey from the VM (after docker cp or rsync). Required for crypto-api.
EZKEY_ENCRYPTION_SECRETS_DIR=./encryption-secrets-local

# Optional host port overrides
CRYPTO_API_PORT=9090
DEMO_DEVICE_PORT=8083
DEMO_APP_ACME_PORT=8082
