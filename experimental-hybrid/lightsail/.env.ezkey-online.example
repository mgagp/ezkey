# Community host (ezkey.online) — example URL / CORS values for lightsail/.env on the VM.
# Copy from .env.example first, then overlay the values below (or start from this file and
# fill remaining secrets from .env.example). Never commit a real .env or Origin CA PEMs.
#
# See docs/lightsail/community-host.md § Ordered path to a working community host.
# Admin UI hostname (Pages) is listed for CORS; Pages project setup is a separate operator step.

# Public Auth API URL (scheme + host, no trailing path). Must match Caddy hostname for auth-api.
EZKEY_QR_AUTH_BASE_URL=https://auth-api.ezkey.online

# Admin UI origin(s) for CORS (Pages custom domain + optional marketing origins).
# Include ezkey.org (+ www) for community-signup.html cross-origin POSTs from the marketing site.
EZKEY_ADMIN_CORS_ALLOWED_ORIGINS=https://admin-ui.ezkey.online,https://ezkey.org,https://www.ezkey.org
# Mode B (Pages Admin UI + HttpOnly session cookie): both must be true, and
# EZKEY_ADMIN_CORS_ALLOWED_ORIGINS must include the exact Admin UI origin above.
# Pair with UI build VITE_ADMIN_AUTH_USE_HTTP_ONLY_SESSION_COOKIE=true (operator root .env).
# Setting either to false breaks credentialed login (credentials: include) on admin-ui.ezkey.online.
EZKEY_ADMIN_CORS_ALLOW_CREDENTIALS=true
EZKEY_ADMIN_AUTH_BROWSER_SESSION_COOKIE_ENABLED=true
EZKEY_ADMIN_AUTH_BROWSER_SESSION_COOKIE_SECURE=true

# Trusted reverse-proxy CIDRs — keep aligned with .env.example / EXP1 (Caddy on Docker bridge).
EZKEY_TRUSTED_PROXIES_CIDRS=172.16.0.0/12,10.0.0.0/8,172.17.0.0/16
EZKEY_TRUSTED_PROXIES_REQUIRED=true

# Hostname lock (Caddyfile.ezkey-online + Cloudflare DNS / Origin CA SANs):
#   admin-ui.ezkey.online          → Cloudflare Pages (not Caddy)
#   admin-api.ezkey.online         → admin-api:9080
#   auth-api.ezkey.online          → auth-api:8080
#   integration-api.ezkey.online   → integration-api:7080
#   demo-acme.ezkey.online         → demo-app-acme:8082
#
# For UI builds / Wrangler: VITE_API_BASE_URL=https://admin-api.ezkey.online
# (set in operator root .env or CI secrets — not in this file).
#
# demo-acme HTTPS redirects: compose sets SERVER_FORWARD_HEADERS_STRATEGY=framework so Spring
# honours X-Forwarded-Proto from Caddy (see community-host.md § demo-acme).

# Audrey/Marc naming lock (community instance branding + bootstrap admin).
# Spelling: Ezkey (never EasyKey). Do NOT claim production/SLA.
EZKEY_ORGANIZATION_NAME=Ezkey Community
EZKEY_ORGANIZATION_DESCRIPTION=Public community MFA instance for evaluation � alpha, best-effort, no SLA.
EZKEY_ORGANIZATION_ABOUT_URL=https://ezkey.org/community-instance.html

# Bootstrap global admin for clean-start seeds (NOT admin.docker on community).
EZKEY_ADMIN_INITIAL_USERNAME=admin.community
EZKEY_ADMIN_INITIAL_EMAIL=admin@ezkey.local
EZKEY_ADMIN_INITIAL_FIRST_NAME=Admin
EZKEY_ADMIN_INITIAL_LAST_NAME=Community

# Anonymous evaluator self-registration (community). Enable on this host only.
# admin-ui-url and guided-tour-url are required when enabled=true (Admin API fails startup
# if blank � no product default hostname). Overlay must set both.
EZKEY_EVALUATOR_SELF_REGISTRATION_ENABLED=true
EZKEY_EVALUATOR_SELF_REGISTRATION_ADMIN_UI_URL=https://admin-ui.ezkey.online
EZKEY_EVALUATOR_SELF_REGISTRATION_GUIDED_TOUR_URL=https://ezkey.org/community-guided-tour.html
