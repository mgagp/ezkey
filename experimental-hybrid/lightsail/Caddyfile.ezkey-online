# Community Lightsail (ezkey.online) — TLS termination and reverse proxy for Ezkey APIs.
#
# Product hostnames (PR #609 / Marc lock). EXP1 keeps experimental-hybrid/lightsail/Caddyfile
# (exp1-*.ezkey.org). Do NOT overwrite EXP1's Caddyfile with this file.
#
# On the community VM, install as the active Caddyfile (Compose bind-mounts ./Caddyfile) via scp only:
#   scp experimental-hybrid/lightsail/Caddyfile.ezkey-online \
#       ezkey-online:ezkey/experimental-hybrid/lightsail/Caddyfile
# Do not rely on a local `cp` of Caddyfile.ezkey-online on the VM — that variant is not present
# after --sync-operator-files (which copies the EXP1 Caddyfile). Always scp from the repo, verify
# sha256 against the repo, then recreate the caddy service.
#
# Model: Cloudflare proxied (orange) DNS → this host. Use a Cloudflare Origin Certificate
# covering the hostnames below; place PEM files in ./caddy-certs/ on the VM.
# See docs/lightsail/community-host.md and DEPLOYMENT_PLAYBOOK.md (Cloudflare / TLS).
#
# TLS: Ezkey is opinionated — only TLS 1.3 is offered here (no TLS 1.2). Older clients cannot connect.
#
# Client IP hardening: trust only Cloudflare edge ranges, then overwrite CF-Connecting-IP /
# X-Forwarded-For with {client_ip} and strip client-supplied Forwarded / X-Real-IP. Recheck the
# CIDR lists against https://www.cloudflare.com/ips-v4 and ips-v6 at every community upgrade.
# IPv4 ranges must match the Lightsail firewall HTTPS rules.
{
	servers {
		trusted_proxies static \
 173.245.48.0/20 \
 103.21.244.0/22 \
 103.22.200.0/22 \
 103.31.4.0/22 \
 141.101.64.0/18 \
 108.162.192.0/18 \
 190.93.240.0/20 \
 188.114.96.0/20 \
 197.234.240.0/22 \
 198.41.128.0/17 \
 162.158.0.0/15 \
 104.16.0.0/13 \
 104.24.0.0/14 \
 172.64.0.0/13 \
 131.0.72.0/22 \
 2400:cb00::/32 \
 2606:4700::/32 \
 2803:f800::/32 \
 2405:b500::/32 \
 2405:8100::/32 \
 2a06:98c0::/29 \
 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(ezkey_online_public_docs_block) {
	@blockedDocs {
		path /api-docs /api-docs/* /swagger-ui /swagger-ui/* /swagger-ui.html /swagger-ui.html*
	}
	respond @blockedDocs 404
}

auth-api.ezkey.online {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem {
		protocols tls1.3 tls1.3
	}
	import ezkey_online_public_docs_block
	reverse_proxy auth-api:8080 {
		header_up CF-Connecting-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
		header_up -Forwarded
		header_up -X-Real-IP
	}
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

admin-api.ezkey.online {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem {
		protocols tls1.3 tls1.3
	}
	import ezkey_online_public_docs_block
	reverse_proxy admin-api:9080 {
		header_up CF-Connecting-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
		header_up -Forwarded
		header_up -X-Real-IP
	}
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

integration-api.ezkey.online {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem {
		protocols tls1.3 tls1.3
	}
	import ezkey_online_public_docs_block
	reverse_proxy integration-api:7080 {
		header_up CF-Connecting-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
		header_up -Forwarded
		header_up -X-Real-IP
	}
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

demo-acme.ezkey.online {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem {
		protocols tls1.3 tls1.3
	}
	# Explicit forwarded headers so Spring (forward-headers-strategy) keeps https on redirects.
	# Keep X-Forwarded-Proto / X-Forwarded-Host; harden IP headers below.
	reverse_proxy demo-app-acme:8082 {
		header_up CF-Connecting-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
		header_up -Forwarded
		header_up -X-Real-IP
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
}
