# Community Lightsail (ezkey.online) — TLS termination and reverse proxy for Ezkey APIs.
#
# Product hostnames (PR #609 / Marc lock): *.ezkey.online.
#
# On the community VM, install as the active Caddyfile (Compose bind-mounts ./Caddyfile).
# --sync-operator-files copies Caddyfile.ezkey-online → remote Caddyfile. Always scp from the
# repo (or use the export script), verify sha256 against the repo, then recreate the caddy service.
#
# Manual install example:
#   scp experimental-hybrid/lightsail/Caddyfile.ezkey-online \
#       ezkey-online:ezkey/experimental-hybrid/lightsail/Caddyfile
#
# Model: Cloudflare proxied (orange) DNS → this host. Use a Cloudflare Origin Certificate
# covering the hostnames below; place PEM files in ./caddy-certs/ on the VM.
# See docs/lightsail/community-host.md and DEPLOYMENT_PLAYBOOK.md (Cloudflare / TLS).
#
# TLS: Ezkey is opinionated — only TLS 1.3 is offered here (no TLS 1.2). Older clients cannot connect.
#
# Client IP hardening: trust only Cloudflare edge ranges, then overwrite CF-Connecting-IP /
# X-Forwarded-For with {client_ip} and strip client-supplied Forwarded / X-Real-IP. Recheck the
# CIDR lists against https://www.cloudflare.com/ips-v4 and ips-v6 at every community upgrade.
# IPv4 ranges must match the Lightsail firewall HTTPS rules.
{
	servers {
		trusted_proxies static \
 173.245.48.0/20 \
 103.21.244.0/22 \
 103.22.200.0/22 \
 103.31.4.0/22 \
 141.101.64.0/18 \
 108.162.192.0/18 \
 190.93.240.0/20 \
 188.114.96.0/20 \
 197.234.240.0/22 \
 198.41.128.0/17 \
 162.158.0.0/15 \
 104.16.0.0/13 \
 104.24.0.0/14 \
 172.64.0.0/13 \
 131.0.72.0/22 \
 2400:cb00::/32 \
 2606:4700::/32 \
 2803:f800::/32 \
 2405:b500::/32 \
 2405:8100::/32 \
 2a06:98c0::/29 \
 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(ezkey_online_public_docs_block) {
	@blockedDocs {
		path /api-docs /api-docs/* /swagger-ui /swagger-ui/* /swagger-ui.html /swagger-ui.html*
	}
	respond @blockedDocs 404
}

# JavaMelody / Actuator must never be reachable via the public reverse proxy (#846).
# Management-port reports stay on the Docker network only; collector is SSH-tunnel loopback.
# Regex validated against Caddy 2.10 matcher syntax (path_regexp): case-insensitive,
# one-or-more leading slashes, path separator / or ; (matrix/path-param style).
(ezkey_online_observability_deny) {
	@blockedObs path_regexp (?i)^/+(monitoring|actuator)([/;].*)?$
	respond @blockedObs 404
}

auth-api.ezkey.online {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem {
		protocols tls1.3 tls1.3
	}
	import ezkey_online_public_docs_block
	import ezkey_online_observability_deny
	reverse_proxy auth-api:8080 {
		header_up CF-Connecting-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
		header_up -Forwarded
		header_up -X-Real-IP
	}
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

admin-api.ezkey.online {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem {
		protocols tls1.3 tls1.3
	}
	import ezkey_online_public_docs_block
	import ezkey_online_observability_deny
	# Site-level access log (#831 / #833 C1). `log` does not take a path matcher — a matcher
	# token is treated as a logger *name* and would log every route. Skip non-auth with
	# log_skip; redact headers, cookies, and sensitive query keys via format filter.
	# Docker json-file rotation for this container: compose x-logging max-size 20m / max-file 3
	# (see docs/lightsail/community-host.md § Docker json-file log rotation).
	log {
		output stdout
		format filter {
			wrap json
			request>headers delete
			request>uri query {
				delete token
				delete proof
				delete challenge
				delete waiterSecret
				delete code
			}
			resp_headers delete
		}
	}
	@skipAdminAuthLog not path /api/v1/admin/auth/*
	log_skip @skipAdminAuthLog
	reverse_proxy admin-api:9080 {
		header_up CF-Connecting-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
		header_up -Forwarded
		header_up -X-Real-IP
	}
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

integration-api.ezkey.online {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem {
		protocols tls1.3 tls1.3
	}
	import ezkey_online_public_docs_block
	import ezkey_online_observability_deny
	reverse_proxy integration-api:7080 {
		header_up CF-Connecting-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
		header_up -Forwarded
		header_up -X-Real-IP
	}
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

demo-acme.ezkey.online {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem {
		protocols tls1.3 tls1.3
	}
	# demo-app-acme exposes /actuator/health on the business port — deny at the edge (#846 / Edgar).
	import ezkey_online_observability_deny
	# Explicit forwarded headers so Spring (forward-headers-strategy) keeps https on redirects.
	# Keep X-Forwarded-Proto / X-Forwarded-Host; harden IP headers below.
	reverse_proxy demo-app-acme:8082 {
		header_up CF-Connecting-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
		header_up -Forwarded
		header_up -X-Real-IP
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
}
