# SMTP connector secrets for the community host (#1206 step 7). Read by docker-compose.connector-smtp.yml.
#
# On the VM: copy to connector-smtp.env next to docker-compose.yml, then chmod 600 connector-smtp.env.
# Never commit the real file and never merge these keys into .env (admin-api loads all of .env).
#
# Values: the SES SMTP credentials of the IAM user ezkey-community-smtp (region ca-central-1;
# a password derived for another region fails). The user name looks like an access key id (AKIA...),
# not the IAM user name. No quotes, no spaces.
EZKEY_CONNECTOR_SMTP_USERNAME=
EZKEY_CONNECTOR_SMTP_PASSWORD=
