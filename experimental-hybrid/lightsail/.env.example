# Copy to .env next to docker-compose.yml on the VM and adjust values.
# This file is the **EXP1 playbook** example (exp1-*.ezkey.org). For community (ezkey.online),
# start from this file then overlay [.env.ezkey-online.example](.env.ezkey-online.example).
# Product / compose defaults carry **no** public hostname — set EZKEY_QR_AUTH_BASE_URL explicitly.
# EZKEY_QR_AUTH_BASE_URL must be the public HTTPS base for the Auth API (mobile / QR / instance-info).

TZ=UTC

POSTGRES_DB=ezkey_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ezkey

SPRING_PROFILES_ACTIVE=docker

# Product runtime profile (integrity = default; base = opt-in).
# Base: MFA crypto on; audit-integrity monitoring off — legitimate ops posture with limited
# claims (not tamper-evident). When base, include docker-base last in SPRING_PROFILES_ACTIVE
# (or use a start path that sources docker/runtime-profile.sh after setting
# EZKEY_RUNTIME_PROFILE=base).
# EZKEY_RUNTIME_PROFILE=integrity
# EZKEY_RUNTIME_PROFILE=base
# SPRING_PROFILES_ACTIVE=docker,docker-base

# Public Auth API URL (scheme + host, no trailing path). Must match Caddy hostname for auth-api.
# EXP1 example value below — community uses .env.ezkey-online.example instead.
EZKEY_QR_AUTH_BASE_URL=https://exp1-auth-api.ezkey.org

# Admin UI origin(s) for CORS when UI and API are on different hosts (e.g. Pages + API). Comma-separated.
# Include https://ezkey.org when anonymous evaluator signup is enabled (exp1-signup.html cross-origin POST).
# EXP1 example values — community overlay replaces these.
EZKEY_ADMIN_CORS_ALLOWED_ORIGINS=https://exp1-admin-ui.ezkey.org,https://ezkey.org
# Mode B (Pages cookie / credentials: include): set BOTH to true and keep CORS origins = Admin UI origin.
# Community (ezkey.online) defaults: see .env.ezkey-online.example (true/true). EXP1 lab defaults below stay false unless you enable Mode B.
EZKEY_ADMIN_CORS_ALLOW_CREDENTIALS=false
# Optional: HttpOnly browser session cookie (pair with root .env VITE_ADMIN_AUTH_USE_HTTP_ONLY_SESSION_COOKIE=true for UI build).
EZKEY_ADMIN_AUTH_BROWSER_SESSION_COOKIE_ENABLED=false
EZKEY_ADMIN_AUTH_BROWSER_SESSION_COOKIE_SECURE=true

# Instance branding (maps to ezkey.organization.* / public instance-info).
# Community host (ezkey.online): use the Audrey/Marc lock from .env.ezkey-online.example.
EZKEY_ORGANIZATION_NAME=Ezkey System
EZKEY_ORGANIZATION_DESCRIPTION=Ezkey MFA instance for your organization
EZKEY_ORGANIZATION_ABOUT_URL=

# Trusted reverse-proxy CIDRs (comma-separated). Spring property: ezkey.trusted-proxies.cidrs.
# Must include the Docker network so Caddy is trusted; APIs and demo-app-acme then read CF-Connecting-IP / X-Forwarded-For (browser → Cloudflare → Caddy → app).
EZKEY_TRUSTED_PROXIES_CIDRS=172.16.0.0/12,10.0.0.0/8,172.17.0.0/16
# Fail-fast if CIDRs are missing/invalid (SEC-011). Keep true on EXP1 (always behind Caddy).
EZKEY_TRUSTED_PROXIES_REQUIRED=true

# Production-like security posture (Spring profile docker already sets these; listed for operator visibility):
# - ezkey.rate-limit.enabled=true (Auth API — SEC-005)
# - ezkey.encryption.required=true (SEC-002)
# - ezkey.audit.integrity.required=true (SEC-008)
# Override only if deliberately softening a lab instance:
# EZKEY_ENCRYPTION_REQUIRED=true
# EZKEY_AUDIT_INTEGRITY_REQUIRED=true

# Admin bootstrap
EZKEY_ADMIN_INITIAL_USERNAME=admin.docker
EZKEY_ADMIN_INITIAL_EMAIL=admin@ezkey.local
EZKEY_ADMIN_INITIAL_FIRST_NAME=Admin
EZKEY_ADMIN_INITIAL_LAST_NAME=Docker
EZKEY_ADMIN_MFA_BOOTSTRAP_CREDENTIALS_OUTPUT_MODE=full
EZKEY_DATABASE_PARTITION_SCHEDULER_CRON=0 */20 * * * ?

# Anonymous evaluator self-registration. Default false in code; enable only on a live preview
# surface. When enabled=true, Admin API fails startup unless both URLs below are set (no product
# default hostname). EXP1 example values when enabling on the lab stack:
# EZKEY_EVALUATOR_SELF_REGISTRATION_ENABLED=true
# EZKEY_EVALUATOR_SELF_REGISTRATION_ADMIN_UI_URL=https://exp1-admin-ui.ezkey.org
# EZKEY_EVALUATOR_SELF_REGISTRATION_GUIDED_TOUR_URL=https://ezkey.org/exp1-guided-tour.html
EZKEY_EVALUATOR_SELF_REGISTRATION_ENABLED=false

# Removed: EZKEY_ADMIN_AUTH_API_KEY_AUTH_ATTEMPTS_ENABLED. Admin API no longer authenticates
# API keys. If this key exists on the live VM `.env`, delete it. Do not re-add it.
