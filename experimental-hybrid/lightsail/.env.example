# Copy to .env next to docker-compose.yml on the VM and adjust values.
# EZKEY_QR_AUTH_BASE_URL must be the public HTTPS base for the Auth API (mobile / QR / instance-info).

TZ=UTC

POSTGRES_DB=ezkey_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ezkey

SPRING_PROFILES_ACTIVE=docker

# Public Auth API URL (scheme + host, no trailing path). Must match Caddy hostname for auth-api.
EZKEY_QR_AUTH_BASE_URL=https://exp1-auth-api.ezkey.org

# Admin UI origin(s) for CORS when UI and API are on different hosts (e.g. Pages + API). Comma-separated.
EZKEY_ADMIN_CORS_ALLOWED_ORIGINS=https://exp1-admin-ui.ezkey.org

# Optional
EZKEY_ORGANIZATION_ABOUT_URL=

# Trusted reverse-proxy CIDRs (Docker bridge + private nets). Adjust if your Docker network differs.
EZKEY_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,172.17.0.0/16

# Demo MITM simulation (see docs/DEMO_MITM_SIGNATURE.md). Use false for production-like Auth API.
EZKEY_DEMO_MITM_SIGNATURE_ENABLED=true

# Admin bootstrap
EZKEY_ADMIN_INITIAL_USERNAME=admin.docker
EZKEY_ADMIN_INITIAL_EMAIL=admin@ezkey.local
EZKEY_ADMIN_INITIAL_FIRST_NAME=Admin
EZKEY_ADMIN_INITIAL_LAST_NAME=Docker
EZKEY_ADMIN_MFA_BOOTSTRAP_CREDENTIALS_OUTPUT_MODE=full
EZKEY_DATABASE_PARTITION_SCHEDULER_CRON=0 */20 * * * ?
