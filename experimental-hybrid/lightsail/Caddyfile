# Experimental Lightsail — TLS termination and reverse proxy for Ezkey APIs.
#
# Model: Cloudflare proxied (orange) DNS → this host. Use a Cloudflare Origin Certificate
# (SSL/TLS → Origin Server) for exp1-*-api hostnames; place PEM files in ./caddy-certs/ on the VM.
# See DEPLOYMENT_PLAYBOOK.md (Cloudflare / TLS).
#
# TLS: Ezkey is opinionated — only TLS 1.3 is offered here (no TLS 1.2). Older clients cannot connect.

(exp1_public_docs_block) {
	@blockedDocs {
		path /api-docs /api-docs/* /swagger-ui /swagger-ui/* /swagger-ui.html /swagger-ui.html*
	}
	respond @blockedDocs 404
}

exp1-auth-api.ezkey.org {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem {
		protocols tls1.3 tls1.3
	}
	import exp1_public_docs_block
	reverse_proxy auth-api:8080
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

exp1-admin-api.ezkey.org {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem {
		protocols tls1.3 tls1.3
	}
	import exp1_public_docs_block
	reverse_proxy admin-api:9080
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

