<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.ezkey</groupId>
		<artifactId>ezkey-parent</artifactId>
		<version>${revision}${buildQualifier}${changelist}</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>ezkey-demo-device</artifactId>
	<name>Ezkey Demo Device</name>
	<description>Demo device simulator for mobile authentication</description>

	<packaging>jar</packaging>

	<dependencies>
		<!-- Spring Boot Starters -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>


		<!-- WebJars for simple styling (optional) -->
		<dependency>
			<groupId>org.webjars</groupId>
			<artifactId>webjars-locator-lite</artifactId>
		</dependency>
		<dependency>
			<groupId>org.webjars</groupId>
			<artifactId>bootstrap</artifactId>
			<version>5.3.8</version>
		</dependency>

		<!-- QR decode from pasted/dropped images (enrollment flow) -->
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>jsqr</artifactId>
			<version>1.4.0</version>
		</dependency>

		<!-- HTTP Client for Ezkey Auth API calls -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webflux</artifactId>
		</dependency>

		<!-- Actuator for Docker / Compose health checks (GET /actuator/health) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Validation API for generated DTOs -->
		<dependency>
			<groupId>jakarta.validation</groupId>
			<artifactId>jakarta.validation-api</artifactId>
		</dependency>

		<!-- Testing -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Spring Boot Maven Plugin -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<!--
				  IMPORTANT:
				  The parent POM configures spring-boot-maven-plugin with an <includes> list ("include nothing")
				  that can result in a repackaged JAR missing BOOT-INF/lib dependencies.
				  For demo-device we must produce a proper fat Spring Boot JAR.
				  combine.self="override" prevents Maven from merging the parent configuration into this module.

				  Spring Boot automatically generates the classifier "original" when repackaging.
				  This is required by ezkey-tests module which needs access to main classes for compilation.
				-->
				<configuration combine.self="override"/>
				<executions>
					<execution>
						<goals>
							<goal>repackage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- OpenAPI Generator Plugin (same parameters as demo-acme-app) -->
			<plugin>
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
				<version>7.25.0</version>
				<executions>
					<execution>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${project.basedir}/openapi-spec.json</inputSpec>
							<generatorName>java</generatorName>
							<addCompileSourceRoot>false</addCompileSourceRoot>
							<generateApis>false</generateApis>
							<generateApiTests>false</generateApiTests>
							<generateApiDocumentation>false</generateApiDocumentation>
							<generateSupportingFiles>false</generateSupportingFiles>
							<generateModelTests>false</generateModelTests>
							<generateModelDocumentation>true</generateModelDocumentation>
							<configOptions>
			                    <!-- Configuration temporelle -->
			                    <dateLibrary>java8</dateLibrary>
			                    <modelDateTimeMapping>LocalDateTime</modelDateTimeMapping>
			                    <modelFormatAnnotation>true</modelFormatAnnotation>
			                    <modelFormatPattern>yyyy-MM-dd'T'HH:mm:ss.SSSSSS</modelFormatPattern>

			                    <!-- Configuration Spring/Jakarta -->
			                    <library>resttemplate</library>
			                    <useJakartaEe>true</useJakartaEe>
			                    <useSpringBoot4>true</useSpringBoot4>
			                    <hideGenerationTimestamp>true</hideGenerationTimestamp>

			                    <!-- Configuration validation/sérialisation -->
			                    <useBeanValidation>true</useBeanValidation>
			                    <jacksonJsonInclude>NON_NULL</jacksonJsonInclude>
			                    <openApiNullable>false</openApiNullable>

			                    <!-- Configuration nommage -->
			                    <modelPropertyNaming>original</modelPropertyNaming>
							</configOptions>
							<typeMappings>
								<typeMapping>string+localDateTime=LocalDateTime</typeMapping>
								<typeMapping>string+localTime=LocalTime</typeMapping>
								<typeMapping>string+date-time=LocalTime</typeMapping>
							</typeMappings>
							<importMappings>
								<importMapping>java.time.OffsetDateTime=java.time.LocalDateTime</importMapping>
							</importMappings>
							<schemaMappings>
								<mapping>LocalDateTime=java.time.LocalDateTime</mapping>
								<mapping>LocalTime=java.time.LocalTime</mapping>
							</schemaMappings>
							<output>${project.build.directory}/generated-sources/openapi</output>
							<modelPackage>org.ezkey.demodevice.generated.dto</modelPackage>
							<apiPackage>org.ezkey.demodevice.generated.api</apiPackage>
							<invokerPackage>org.ezkey.demodevice.generated.client</invokerPackage>
							<modelNameSuffix></modelNameSuffix>
							<removeOperationIdPrefix>true</removeOperationIdPrefix>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Compile generated Auth API DTOs only (models). The java/resttemplate generator
			     still emits client helpers (RFC3339*, ApiClient) that import
			     com.fasterxml.jackson.databind; useJackson3 is not supported for resttemplate.
			     WebClient uses Spring Boot 4 Jackson 3 codecs; DTOs keep
			     com.fasterxml.jackson.annotation by design (JSTEP-1). -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.6.2</version>
				<executions>
					<execution>
						<id>add-generated-source</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>${project.build.directory}/generated-sources/openapi/src/main/java/org/ezkey/demodevice/generated/dto</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
