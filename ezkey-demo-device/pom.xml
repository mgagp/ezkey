<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	
	<parent>
		<groupId>org.ezkey</groupId>
		<artifactId>ezkey-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	
	<artifactId>ezkey-demo-device</artifactId>
	<name>Ezkey Demo Device</name>
	<description>Demo device simulator for mobile authentication</description>
	
	<packaging>jar</packaging>

	<dependencies>
		<!-- Spring Boot Starters -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<!-- WebJars for simple styling (optional) -->
		<dependency>
			<groupId>org.webjars</groupId>
			<artifactId>webjars-locator-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.webjars</groupId>
			<artifactId>bootstrap</artifactId>
			<version>5.3.2</version>
		</dependency>

		<!-- HTTP Client for Ezkey Auth API calls -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webflux</artifactId>
		</dependency>

		<!-- Jackson for JSON processing (required for generated DTOs) -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-annotations</artifactId>
		</dependency>

		<!-- OpenAPI annotations (used by generated DTOs in some cases) -->
		<dependency>
			<groupId>io.swagger.core.v3</groupId>
			<artifactId>swagger-annotations</artifactId>
			<version>2.2.8</version>
		</dependency>

		<!-- Validation API for generated DTOs -->
		<dependency>
			<groupId>jakarta.validation</groupId>
			<artifactId>jakarta.validation-api</artifactId>
		</dependency>

		<!-- JsonNullable library for OpenAPI generated DTOs -->
		<dependency>
			<groupId>org.openapitools</groupId>
			<artifactId>jackson-databind-nullable</artifactId>
			<version>0.2.6</version>
		</dependency>

		<!-- Cryptography: BouncyCastle for Ed25519 signatures -->
		<dependency>
			<groupId>org.bouncycastle</groupId>
			<artifactId>bcprov-jdk18on</artifactId>
			<version>1.78.1</version>
		</dependency>

		<!-- Testing -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Spring Boot Maven Plugin -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>repackage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- OpenAPI Generator Plugin (same parameters as demo-acme-app) -->
			<plugin>
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
				<version>7.14.0</version>
				<executions>
					<execution>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${project.basedir}/openapi-spec.json</inputSpec>
							<generatorName>java</generatorName>
							<configOptions>
			                    <!-- Configuration temporelle -->
			                    <dateLibrary>java8</dateLibrary>
			                    <modelDateTimeMapping>LocalDateTime</modelDateTimeMapping>
			                    <modelFormatAnnotation>true</modelFormatAnnotation>
			                    <modelFormatPattern>yyyy-MM-dd'T'HH:mm:ss.SSSSSS</modelFormatPattern>
			                    
			                    <!-- Configuration Spring/Jakarta -->
			                    <library>resttemplate</library>
			                    <useJakartaEe>true</useJakartaEe>
			                    <useSpringBoot3>true</useSpringBoot3>
			                    
			                    <!-- Configuration génération -->
			                    <generateApis>false</generateApis>
			                    <generateSupportingFiles>false</generateSupportingFiles>
			                    <generateApiDocumentation>false</generateApiDocumentation>
			                    <hideGenerationTimestamp>true</hideGenerationTimestamp>
			                    
			                    <!-- Configuration validation/sérialisation -->
			                    <useBeanValidation>true</useBeanValidation>
			                    <jacksonJsonInclude>NON_NULL</jacksonJsonInclude>
			                    <openApiNullable>false</openApiNullable>
			                    
			                    <!-- Configuration nommage -->
			                    <modelPropertyNaming>original</modelPropertyNaming>
							</configOptions>
							<typeMappings>
								<typeMapping>string+localDateTime=LocalDateTime</typeMapping>
								<typeMapping>string+localTime=LocalTime</typeMapping>
								<typeMapping>string+date-time=LocalTime</typeMapping>
							</typeMappings>
							<importMappings>
								<importMapping>java.time.OffsetDateTime=java.time.LocalDateTime</importMapping>
							</importMappings>
							<schemaMappings>
								<mapping>LocalDateTime=java.time.LocalDateTime</mapping>
								<mapping>LocalTime=java.time.LocalTime</mapping>
							</schemaMappings>
							<output>${project.build.directory}/generated-sources/openapi</output>
							<modelPackage>org.ezkey.demodevice.generated.dto</modelPackage>
							<apiPackage>org.ezkey.demodevice.generated.api</apiPackage>
							<invokerPackage>org.ezkey.demodevice.generated.client</invokerPackage>
							<generateModelDocumentation>true</generateModelDocumentation>
							<generateApiDocumentation>false</generateApiDocumentation>
							<modelNameSuffix></modelNameSuffix>
							<removeOperationIdPrefix>true</removeOperationIdPrefix>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Add generated sources to compilation -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.4.0</version>
				<executions>
					<execution>
						<id>add-generated-source</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>${project.build.directory}/generated-sources/openapi/src/main/java</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project> 