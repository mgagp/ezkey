# Minimal sshd configuration for the Ezkey PAM SSH demo container.
Port 22
Protocol 2
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_ed25519_key
SyslogFacility AUTHPRIV
LogLevel VERBOSE
PermitRootLogin no
PubkeyAuthentication no
PasswordAuthentication no
KbdInteractiveAuthentication yes
ChallengeResponseAuthentication yes
UsePAM yes
AuthenticationMethods keyboard-interactive
X11Forwarding no
PrintMotd yes
AcceptEnv LANG LC_*
Subsystem sftp /usr/libexec/openssh/sftp-server
LoginGraceTime 120
# One PAM authenticate per SSH try — keeps M1 attempt-line demos/tests unambiguous.
MaxAuthTries 1
# OpenSSH 9.9+ default PerSourcePenalties (authfail:5) blocks the client IP after a
# handful of denied logins — breaks M1 conf-security rapid UNAVAIL proofs from
# localhost. Lab demo only; do not copy this disable onto a hardened host.
PerSourcePenalties no
