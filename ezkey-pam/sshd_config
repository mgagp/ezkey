# Minimal sshd configuration for the Ezkey PAM SSH demo container.
Port 22
Protocol 2
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_ed25519_key
SyslogFacility AUTHPRIV
LogLevel VERBOSE
PermitRootLogin no
PubkeyAuthentication no
PasswordAuthentication no
KbdInteractiveAuthentication yes
ChallengeResponseAuthentication yes
UsePAM yes
AuthenticationMethods keyboard-interactive
X11Forwarding no
PrintMotd yes
AcceptEnv LANG LC_*
Subsystem sftp /usr/libexec/openssh/sftp-server
LoginGraceTime 120
# Do NOT set MaxAuthTries 1 globally: refused public keys also consume tries.
# Single Ezkey keyboard-interactive try is enforced per-user Match below
# (#907 option A — OpenSSH forks each kbdint round; PAM markers do not span).
MaxAuthTries 6
# OpenSSH 9.9+ default PerSourcePenalties (authfail:5) blocks the client IP after a
# handful of denied logins — breaks M1 conf-security rapid UNAVAIL proofs from
# localhost. Lab demo only; do not copy this disable onto a hardened host.
PerSourcePenalties no

# Demo MFA user: one auth try per TCP session (prevents F9 orphan create).
# Host installs: MANDATORY Match Group ezkey-mfa (or Match User) with
# MaxAuthTries 1 — each prompt round = one auth request (README / sshd.host-sketch).
# PubkeyAuthentication no: refused pubkey would consume the single try (security GO).
Match User testuser
	MaxAuthTries 1
	AuthenticationMethods keyboard-interactive
	PubkeyAuthentication no
