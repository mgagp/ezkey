# Copy to .env (gitignored) or export before ./scripts/up.sh.
# Quote values that contain spaces. Scripts parse this file; they do not execute it.
EZKEY_INTEGRATION_API_URL=http://integration-api:7080
EZKEY_INTEGRATION_KEY=
EZKEY_SECRET_KEY=
EZKEY_SSH_USER=testuser
EZKEY_WAIT_TIMEOUT=90
EZKEY_PAM_SSH_PORT=2222
EZKEY_CONTEXT_TITLE="SSH login"
EZKEY_DOCKER_NETWORK=ezkey_ezkey-network
# Demo containers default debug on; sample conf for hosts is debug=false.
# EZKEY_DEBUG=true
# AL2023 SSH mirror host port (Rocky demo stays on EZKEY_PAM_SSH_PORT=2222).
# EZKEY_PAM_SSH_PORT_AL2023=2223
