# Copy to `docker/.env` (gitignored) and set values for your machine.
# Docker Compose loads `docker/.env` when present.

# Public Auth API base URL (scheme + host + port) for enrollment QR `authUrl` and
# GET /api/v1/public/instance-info `authApiPublicBaseUrl`. Use your ngrok or public hostname.
# EZKEY_QR_AUTH_BASE_URL=https://your-auth-host.example.com

# Optional "About / learn more" link (`aboutUrl` on GET /api/v1/public/instance-info).
# EZKEY_ORGANIZATION_ABOUT_URL=https://ezkey.org
