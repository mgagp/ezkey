# Copy to `docker/.env` (gitignored) and set values for your machine.
# Docker Compose loads `docker/.env` when present.

# Log timestamps in containers (Admin API, Postgres, etc.): JVM uses the TZ env var.
# Default in compose is UTC if unset — Docker does not infer the host OS timezone.
# Set an IANA zone so `docker logs` matches your local clock (e.g. Eastern in April ≈ UTC-4).
# TZ=America/Toronto

# Public Auth API base URL (scheme + host + port) for enrollment QR `authUrl` and
# GET /api/v1/public/instance-info `authApiPublicBaseUrl` on both Admin API and Auth API.
# Use your ngrok or public hostname.
# EZKEY_QR_AUTH_BASE_URL=https://your-auth-host.example.com

# Instance branding (`instanceName` / `instanceDescription` on public and signed instance-info).
# Passed to both admin-api and auth-api. Also seeds the system tenant and system integration names.
# EZKEY_ORGANIZATION_NAME=Unicorn Farm
# EZKEY_ORGANIZATION_DESCRIPTION=Ezkey MFA instance for ride booking and unicorn care

# Optional "About / learn more" link (`aboutUrl` on GET /api/v1/public/instance-info).
# Passed to both admin-api and auth-api so public instance metadata stays aligned.
# EZKEY_ORGANIZATION_ABOUT_URL=https://ezkey.org

# ---------------------------------------------------------------------------
# PostgreSQL roles (see docs/DATABASE_ROLE_PERMISSIONS_MATRIX.md)
# Superuser (bootstrap / apply-grants / functional-test DB helpers only)
# POSTGRES_PASSWORD=ezkey
# Flyway (ezkey-migration)
# EZKEY_DB_MIGRATE_PASSWORD=ezkey_migrate
# Runtime APIs
# EZKEY_DB_ADMIN_PASSWORD=ezkey_admin
# EZKEY_DB_AUTH_PASSWORD=ezkey_auth
# EZKEY_DB_INTEGRATION_PASSWORD=ezkey_integration
# Role creation runs once on an empty postgres-data volume (docker/postgres/init).
# Recreate the volume (clean-start) when changing role bootstrap.
