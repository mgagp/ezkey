# Copy to `docker/.env` (gitignored) and set values for your machine.
# Docker Compose loads `docker/.env` when present.

# Log timestamps in containers (Admin API, Postgres, etc.): JVM uses the TZ env var.
# Default in compose is UTC if unset — Docker does not infer the host OS timezone.
# Set an IANA zone so `docker logs` matches your local clock (e.g. Eastern in April ≈ UTC-4).
# TZ=America/Toronto

# Public Auth API base URL (scheme + host + port) for enrollment QR `authUrl` and
# GET /api/v1/public/instance-info `authApiPublicBaseUrl` on both Admin API and Auth API.
# Use your ngrok or public hostname.
# EZKEY_QR_AUTH_BASE_URL=https://your-auth-host.example.com

# Optional "About / learn more" link (`aboutUrl` on GET /api/v1/public/instance-info).
# Passed to both admin-api and auth-api so public instance metadata stays aligned.
# EZKEY_ORGANIZATION_ABOUT_URL=https://ezkey.org
