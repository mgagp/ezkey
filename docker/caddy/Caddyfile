# Caddy reverse proxy for EZkey APIs (used by docker-compose.with-proxy.yml).
# Host ports 19080, 18080, 17080 map to Admin API, Auth API, M2M API.
# Requests are forwarded with X-Forwarded-For so apps can resolve client IP when EZKEY_TRUSTED_PROXIES is set.

:9080 {
    reverse_proxy admin-api:9080
}

:8080 {
    reverse_proxy auth-api:8080
}

:7080 {
    reverse_proxy m2m-api:7080
}
