# Caddy reverse proxy for EZkey APIs (docker-compose.with-proxy.yml).
# Host ports 19080, 18080, 17080 map to Admin API, Auth API, Integration API.
# reverse_proxy overwrites X-Forwarded-For with the Caddy peer address so a client-supplied
# header cannot rotate IP-keyed buckets. Apps still resolve client IP via EZKEY_TRUSTED_PROXIES_CIDRS.
#
# Response headers: baseline hardening for API JSON responses (no HTML CSP needed).
#
# Springdoc (/api-docs, Swagger UI) stays on the direct service ports so
# scripts/update-specs.sh can pull live specs (localhost:9080/8080/7080).
# Those paths are not proxied on the Caddy surface (OWASP API9 inventory).

(springdoc_deny) {
	@springdoc path /api-docs* /swagger-ui* /webjars/swagger-ui*
	handle @springdoc {
		respond 404
	}
}

(api_headers) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

:9080 {
	import api_headers
	import springdoc_deny
	handle {
		reverse_proxy admin-api:9080 {
			header_up X-Forwarded-For {remote_host}
		}
	}
}

:8080 {
	import api_headers
	import springdoc_deny
	handle {
		reverse_proxy auth-api:8080 {
			header_up X-Forwarded-For {remote_host}
		}
	}
}

:7080 {
	import api_headers
	import springdoc_deny
	handle {
		reverse_proxy integration-api:7080 {
			header_up X-Forwarded-For {remote_host}
		}
	}
}
