# Copy to docker/connector-smtp.local.env (gitignored) for docker-compose.connector-smtp-gmail.yml.
# Gmail: the account needs 2-Step Verification and an app password (myaccount.google.com/apppasswords).
# The sender must be the account itself or one of its verified aliases.
EZKEY_CONNECTOR_SMTP_USERNAME=you@gmail.com
EZKEY_CONNECTOR_SMTP_PASSWORD=app-password-16-chars
EZKEY_CONNECTOR_SMTP_FROM_ADDRESS=you@gmail.com
